# Copia este archivo a .env.local y completa los valores. Nunca subas el .env real.

# Base de datos Neon (Postgres). DATABASE_URL = conexión agrupada (-pooler) para la app;
# DATABASE_URL_UNPOOLED = conexión directa, usada por las migraciones de Prisma.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Secreto para firmar la cookie de sesión (mínimo 16 caracteres): openssl rand -base64 32
SESSION_SECRET=

# Orígenes del sitio público autorizados a llamar a la API pública (separados por coma).
# El primero también se usa en el QR de los certificados: https://wylar.cl,https://www.wylar.cl
PUBLIC_FORM_ORIGINS=

# Vercel Blob: subida de imágenes del catálogo (lo inyecta Vercel al crear el store).
BLOB_READ_WRITE_TOKEN=

# Solo para `npm run db:seed` (crea usuarios de ejemplo). No lo uses en producción.
SEED_PASSWORD=
