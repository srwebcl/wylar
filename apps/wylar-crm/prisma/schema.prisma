// Schema de base de datos del CRM de Wylar.
//
// Usa PostgreSQL (Neon vía Vercel Marketplace) — es lo que permite
// desplegar en Vercel sin fricción. La URL de conexión no va aquí (Prisma
// 7): se define en prisma.config.ts + DATABASE_URL (ver .env.example).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  // ADMIN | COMERCIAL — ADMIN además administra el equipo (/equipo).
  role         String   @default("COMERCIAL")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  assignedLeads      Lead[]         @relation("AssignedLeads")
  activities         LeadActivity[]
  issuedCertificates Certificate[]
  quotes             Quote[]

  @@map("users")
}

model Lead {
  id   Int    @id @default(autoincrement())
  // Código de referencia visible, ej. LEAD-1001 (se completa tras el insert, ver src/actions/leads.ts).
  code String @unique

  // PERSONA | EMPRESA | INSTITUCION — a qué portal/audiencia de wylar.cl corresponde.
  type String

  name    String
  // RUT del titular/contacto, con formato (ej. "12.345.678-5"). Nullable
  // solo por compatibilidad con leads creados antes de exigirlo — todo
  // formulario nuevo (público o manual) lo valida y lo exige (ver
  // src/lib/rut.ts e isValidRut en validation.ts).
  rut     String?
  rutNorm String? @default("")
  email   String
  phone   String
  // Nombre de la empresa/institución (solo aplica si type != PERSONA).
  company String?

  // Ficha de cliente (dedup por RUT/correo) a la que pertenece esta
  // oportunidad. Toda oportunidad la exige (ver findOrCreateClient en
  // actions/leads.ts) — las ~11 oportunidades previas a este campo ya
  // quedaron migradas (ver backfill en el historial de migraciones).
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  // Producto/servicio del catálogo comercial que originó esta oportunidad
  // — toda alta nueva (pública o manual) lo exige.
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  // Copia del nombre del producto al momento de crear la oportunidad (para
  // que búsqueda/exports no dependan de un join ni cambien si el producto
  // se renombra después — mismo patrón que Certificate.certificationTitle).
  certificationInterest String?
  // Comuna de la solicitud, cuando corresponde (ej. sede del curso).
  comuna String?
  // Mensaje/consulta libre que dejó el cliente en el formulario, si lo hubo.
  message               String? @db.Text

  // Canal de origen detectado automáticamente: WEB | FACEBOOK | INSTAGRAM | WHATSAPP | OTRO
  source       String
  // Detalle crudo usado para detectar el origen (referrer, utm_source/medium/campaign) — trazabilidad.
  sourceDetail String? @db.Text

  // Estado del embudo de ventas: NUEVO | EN_ATENCION | SEGUIMIENTO | CERRADO | DESISTIDO
  status String @default("NUEVO")
  // Motivo del desistimiento — obligatorio cuando status = DESISTIDO (ver changeLeadStatus en actions/leads.ts).
  lostReason String? @db.Text

  assignedToId Int?
  assignedTo   User? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdAt       DateTime  @default(now())
  // Se completa automáticamente en la primera gestión o cambio de estado
  // (ver src/actions/leads.ts) — permite auditar el tiempo de respuesta.
  firstAttendedAt DateTime?
  closedAt        DateTime?

  activities   LeadActivity[]
  certificates Certificate[]
  quotes       Quote[]

  @@index([status])
  @@index([assignedToId])
  @@index([source])
  @@index([rutNorm])
  @@index([clientId])
  @@index([productId])
  @@map("leads")
}

// Ficha única de cliente (persona, empresa, OTEC o institución) — existe una
// sola vez aunque tenga varias oportunidades de venta. Se dedupe por RUT
// (rutNorm) al crear una oportunidad nueva (ver findOrCreateClient en
// src/actions/leads.ts); si no trae RUT se intenta por correo.
model Client {
  id Int @id @default(autoincrement())

  // PERSONA | ALUMNO_BECADO | EMPRESA | INSTITUCION | OTEC (mismos valores que Lead.type).
  type String

  name    String
  rut     String?
  rutNorm String? @default("")
  email   String
  phone   String
  // Razón social (si type no es PERSONA/ALUMNO_BECADO).
  company String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      ClientContact[]
  opportunities Lead[]

  @@index([rutNorm])
  @@map("clients")
}

// Contacto comercial adicional de una organización (ej. "Jefe de Prevención
// de Riesgos"), distinto del contacto principal guardado en Client.
model ClientContact {
  id       Int    @id @default(autoincrement())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int

  name  String
  role  String?
  email String?
  phone String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_contacts")
}

// Bandera de "no contactar" a nivel de persona (no de prospecto puntual):
// se guarda por correo/teléfono, así que si en el futuro se crea OTRO
// prospecto con el mismo contacto, el sistema lo detecta igual aunque sea
// un Lead distinto. No es FK de Lead a propósito — un contacto puede
// quedar marcado sin que exista ningún prospecto activo con él todavía.
model DoNotContactEntry {
  id    Int     @id @default(autoincrement())
  email String?
  phone String?
  reason        String @db.Text
  createdByName String

  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@map("do_not_contact_entries")
}

model LeadActivity {
  id     Int  @id @default(autoincrement())
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId Int

  // Autor de la entrada; null = acción automática del sistema.
  user       User?  @relation(fields: [userId], references: [id])
  userId     Int?
  // Copia plana del nombre, para que el historial no dependa de que el usuario siga existiendo.
  authorName String

  // NOTA | LLAMADA | WHATSAPP | EMAIL | REUNION | CREACION | CAMBIO_ESTADO | ASIGNACION
  type String
  text String @db.Text

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// --- Módulo de Catálogo ---
//
// Perfiles/certificaciones que se exhiben en wylar.cl (GET /api/public/catalog
// y /perfil/[slug]). Hoy wylar.cl tiene esto hardcodeado en su propio
// src/data/perfiles.js, repartido en 3 plantillas de ficha muy distintas
// entre sí (CHILEVALORA, SOLDADURA, OPERADORES — ver
// src/lib/constants.ts#PROFILE_SECTION_SPECS). En vez de modelar cada bloque
// de contenido (FAQ, pasos, "quiénes pueden", procesos de soldadura,
// posiciones, normas, etc.) como una tabla propia — que daría ~15-20 tablas
// casi idénticas para solo 4 perfiles — se usa un patrón de
// sección/ítem genérico pero 100% relacional (nada en JSON): cada bloque de
// contenido es una fila de ProfileSection, y sus viñetas/tarjetas son filas
// de ProfileSectionItem. Qué claves de sección existen y qué forma tiene
// cada una está definido por plantilla en PROFILE_SECTION_SPECS, que es lo
// que genera el formulario de administración en /catalogo.
model Profile {
  id Int @id @default(autoincrement())

  // Identificador en la URL de wylar.cl, ej. "electricista" → /perfil/electricista.
  slug String @unique

  // CHILEVALORA | SOLDADURA | OPERADORES | ESTANDAR — determina qué
  // secciones aplican y qué plantilla de ficha usa wylar.cl (ver
  // PROFILE_SECTION_SPECS). ESTANDAR es la plantilla simple de 6 bloques
  // de texto enriquecido — la única disponible al crear un perfil nuevo
  // desde /catalogo/nuevo (ver ProfileWizard.tsx); las otras 3 siguen
  // existiendo para los perfiles ya cargados con esa forma.
  templateType String

  title       String
  description String @db.Text
  // Descripción larga (HTML del editor de texto enriquecido) — solo la
  // usa la plantilla ESTANDAR, como cuerpo principal de la ficha.
  descriptionLong String? @db.Text
  image       String
  // Imagen vertical especial para la tarjeta del catálogo (si es null se usa image)
  cardImage   String?
  // Ficha Ocupacional en PDF (opcional) — si existe, wylar.cl muestra un
  // botón de descarga en la ficha del perfil.
  fichaUrl    String?

  category  String
  sector    String
  subsector String
  nivel     String
  // Vigencia de la certificación, ej. "2 años" (no aplica a ChileValora).
  vigencia  String?

  // personas | empresas | otec — a quién se dirige, puede tener varios.
  target        String[]
  isChileValora Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  active        Boolean  @default(true)

  heroHook       String   @db.Text
  heroParagraphs String[]
  heroCta        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections     ProfileSection[]
  faqs         ProfileFaq[]
  certificates Certificate[]
  products     Product[]

  @@index([templateType])
  @@index([active])
  @@map("profiles")
}

// Catálogo comercial (distinto del catálogo de marketing de Profile):
// productos/servicios vendibles, con precio y atributos propios según su
// categoría. Las categorías son administrables desde el CRM sin tocar
// código; solo agregar una FORMA de atributos nueva (ver productSpec.ts)
// exige un cambio de código, igual que agregar un templateType a Profile.
model ProductCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Qué campos extra pide el formulario de producto para esta categoría —
  // ver ATTRIBUTE_TEMPLATES en src/lib/productSpec.ts.
  attributeTemplate String  @default("GENERICO")
  active             Boolean @default(true)

  createdAt DateTime @default(now())

  products Product[]

  @@map("product_categories")
}

model Product {
  id         Int             @id @default(autoincrement())
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId Int

  name        String
  description String? @db.Text
  price       Decimal? @db.Decimal(12, 0)
  active      Boolean  @default(true)

  // Atributos específicos de la categoría (técnica/posición de soldadura,
  // perfil ChileValora, horas/fechas/lugar de un curso, etc.) — forma
  // libre en JSON, la define category.attributeTemplate.
  attributes Json?

  // Vínculo opcional a la ficha de marketing de wylar.cl correspondiente,
  // para que su formulario de contacto resuelva automáticamente qué
  // producto le corresponde (mismo patrón que Certificate.profileId) —
  // no es obligatorio, un producto puede no tener ficha pública.
  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Lead[]
  quoteItems    QuoteItem[]

  @@index([categoryId])
  @@index([profileId])
  @@map("products")
}

// Cotización ligada a una oportunidad — pueden existir varias versiones
// (inicial, corregida, contraoferta); las anteriores nunca se sobrescriben,
// solo cambian de estado (ver markQuoteAccepted en actions/quotes.ts).
model Quote {
  id Int @id @default(autoincrement())

  // Código de referencia visible, ej. COT-0001 (se completa tras el insert).
  code String @unique

  opportunity   Lead @relation(fields: [opportunityId], references: [id])
  opportunityId Int

  version Int @default(1)
  // BORRADOR | ENVIADA | REEMPLAZADA | ACEPTADA | RECHAZADA
  status  String @default("BORRADOR")

  issueDate DateTime @default(now())
  notes     String?  @db.Text
  total     Decimal  @db.Decimal(12, 0)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items QuoteItem[]

  @@index([opportunityId])
  @@map("quotes")
}

model QuoteItem {
  id      Int   @id @default(autoincrement())
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId Int

  product   Product? @relation(fields: [productId], references: [id])
  productId Int?
  // Copia del nombre del producto al momento de cotizar (independiente de
  // si el producto cambia de nombre o se desactiva después).
  description String

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 0)
  subtotal  Decimal @db.Decimal(12, 0)

  @@index([quoteId])
  @@map("quote_items")
}

// Un bloque de contenido con nombre (ej. "queEs", "proceso", "normas",
// "posiciones" — ver PROFILE_SECTION_SPECS para el listado completo por
// plantilla). Los campos sueltos (title/text/intro/closing/note) cubren los
// distintos "envoltorios" que usa cada bloque en el dato original; los que
// no aplican quedan null.
model ProfileSection {
  id        Int     @id @default(autoincrement())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int

  key   String
  order Int    @default(0)

  title   String?
  text    String? @db.Text
  intro   String? @db.Text
  closing String? @db.Text
  note    String? @db.Text

  items ProfileSectionItem[]

  @@unique([profileId, key])
  @@map("profile_sections")
}

// Una fila de una sección: puede ser una viñeta simple (solo `text`), una
// tarjeta con título ({title, text} — ej. UCLs, pasos del proceso, "quiénes
// pueden"), o un ítem con código ({code, text} — ej. procesos de soldadura
// SMAW/GMAW) o agrupado ({group, text} — ej. posiciones placa/tubería).
model ProfileSectionItem {
  id        Int            @id @default(autoincrement())
  section   ProfileSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId Int
  order     Int            @default(0)

  group String?
  code  String?
  title String?
  text  String? @db.Text

  @@index([sectionId])
  @@map("profile_section_items")
}

model ProfileFaq {
  id        Int     @id @default(autoincrement())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int
  order     Int     @default(0)

  question String @db.Text
  answer   String @db.Text

  @@index([profileId])
  @@map("profile_faqs")
}

// --- Módulo de Certificados ---
//
// Certificados emitidos a personas (ligados o no a un Lead cerrado). Se
// consultan públicamente por RUT o código desde wylar.cl/validador
// (GET /api/public/certificates/validate) y se pueden descargar en PDF
// (GET /api/public/certificates/[code]/pdf, generado al vuelo con
// @react-pdf/renderer — no se guarda ningún archivo, así el PDF nunca queda
// desactualizado respecto a estos datos).
model Certificate {
  id Int @id @default(autoincrement())

  // Código único de validación, ej. "WYL-2026-XYZ". Es lo que se busca en
  // el validador junto con el RUT (ver src/lib/certificateCode.ts).
  code String @unique

  holderName String
  holderRut  String
  // RUT sin puntos, guion ni espacios y en minúscula: es lo que se busca en el
  // validador público (columna indexada, así la consulta no recorre la tabla).
  holderRutNorm String @default("")

  profile            Profile? @relation(fields: [profileId], references: [id])
  profileId          Int?
  // Copias planas del título y la categoría al momento de emitir, para que
  // el certificado no cambie si el perfil del catálogo se edita o borra
  // después.
  certificationTitle String
  // Etiqueta mostrada en el validador, ej. "Certificación ChileValora" o
  // "Calificación Técnica" (ver PROFILE_SECTION_SPECS / categoryLabel).
  categoryLabel      String
  // Párrafo libre que va bajo el nombre de la certificación en el PDF (ej.
  // duración del curso, fechas, nota obtenida, vigencia). Opcional, solo se
  // usa en el PDF — el validador público no lo muestra.
  detailText         String? @db.Text
  
  completionText     String  @default("Ha completado satisfactoriamente el curso de")

  issueDate  DateTime
  // Vigencia; null = no vence (ej. certificaciones ChileValora). El estado
  // "Vigente"/"Vencido" que ve el validador se calcula en el momento a
  // partir de esta fecha, no se almacena.
  expiryDate DateTime?

  lead   Lead? @relation(fields: [leadId], references: [id])
  leadId Int?

  issuedBy   User? @relation(fields: [issuedById], references: [id])
  issuedById Int?

  // Un certificado revocado no se borra: deja de ser válido pero conserva su
  // historial (quién y cuándo). El validador lo muestra como "Revocado".
  revokedAt     DateTime?
  revokedByName String?

  createdAt DateTime @default(now())

  @@index([holderRut])
  @@index([holderRutNorm])
  @@map("certificates")
}

// Listas administrables desde /certificados/configuracion. Son solo el
// origen de las opciones del formulario de emisión (autocompletar + crear
// al vuelo) — no son FK de Certificate: category/completionText quedan
// copiados como texto plano en cada certificado al emitirse (mismo criterio
// que certificationTitle/categoryLabel arriba), así que borrar o renombrar
// una entrada acá nunca altera certificados ya emitidos.
model CertificateCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("certificate_categories")
}

model CertificateType {
  id    Int    @id @default(autoincrement())
  // Nombre corto que se ve en el selector, ej. "Curso", "Certificación".
  label String @unique
  // Frase exacta que antecede al nombre de la certificación en el PDF, ej.
  // "Ha completado satisfactoriamente el curso de".
  completionText String

  createdAt DateTime @default(now())

  @@map("certificate_types")
}

model CertificationTitle {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("certification_titles")
}

// --- Módulo de Hero (Home de wylar.cl) ---
//
// Slides personalizados del hero de wylar.cl (GET /api/public/hero-slides).
// El sitio les agrega automáticamente, a continuación, un slide por cada
// perfil del catálogo marcado como destacado (Profile.isFeatured) — esos no
// se administran acá, se administran marcando/desmarcando el perfil en
// /catalogo (ver README de wylar-crm).
model HeroSlide {
  id     Int     @id @default(autoincrement())
  order  Int     @default(0)
  active Boolean @default(true)

  image          String
  eyebrowLead    String
  eyebrowAccent  String
  title          String
  titleHighlight String
  description    String @db.Text
  ctaLabel       String
  ctaHref        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

// --- Infraestructura ---

// Contadores para limitar peticiones (login, formularios públicos, validador,
// PDF) sin depender de un servicio externo. Ver src/lib/rateLimit.ts.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

// Registro de acciones sensibles (quién hizo qué). Ver src/lib/audit.ts.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userName   String
  // Ej. CERTIFICADO_EMITIDO, CERTIFICADO_REVOCADO, PERFIL_ELIMINADO, USUARIO_CREADO…
  action     String
  entity     String
  entityId   String?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
