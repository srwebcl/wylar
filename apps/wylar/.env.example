# Variables públicas del sitio (se incrustan en el navegador: no pongas secretos aquí).

# Origen del CRM (para catálogo, banners y validador).
#PUBLIC_CRM_ORIGIN=https://wylar-crm.vercel.app

# Endpoint que recibe los formularios de contacto (opcional: por defecto usa PUBLIC_CRM_ORIGIN).
#PUBLIC_CRM_API_URL=https://wylar-crm.vercel.app/api/public/leads

# Desarrollo local: para NO crear leads reales en el CRM de producción, apunta al CRM local
# (npm run dev en apps/wylar-crm, puerto 3000):
PUBLIC_CRM_ORIGIN=http://localhost:3000
PUBLIC_CRM_API_URL=http://localhost:3000/api/public/leads
