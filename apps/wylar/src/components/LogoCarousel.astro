---
const logos = [
    { src: "/logos-clientes/chilevalora.png", alt: "ChileValora", class: "h-12 md:h-14" },
    { src: "/logos-clientes/sence.png", alt: "SENCE", class: "h-12 md:h-14" },
    { src: "/images/logo-strom.svg", alt: "Strom", class: "h-12 md:h-14" },
    { src: "/images/Logo-Posiciona.webp", alt: "Posiciona", class: "h-12 md:h-14" },
    { src: "/logos-clientes/isudamericana.png", alt: "Sudamericana", class: "h-12 md:h-14" },
    { src: "/logos-clientes/movilockers.webp", alt: "Movilockers", class: "h-12 md:h-14" },
    { src: "/logos-clientes/bp-asesoria.webp", alt: "BP Asesoría", class: "h-8 md:h-9" },
    { src: "/logos-clientes/felice.png", alt: "Felice", class: "h-12 md:h-14" },
    { src: "/logos-clientes/KSA-PROPIEDADES.jpeg", alt: "KSA Propiedades", class: "h-20 md:h-24 mix-blend-multiply" },
    { src: "/logos-clientes/sertac.png", alt: "Sertac", class: "h-12 md:h-14" },
    { src: "/logos-clientes/sustantiva.png", alt: "Sustantiva", class: "h-12 md:h-14" }
];
---

<div class="overflow-hidden relative w-full flex items-center group/carousel">
    <!-- Fades en los bordes para un efecto suave -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
    
    <div class="flex w-max animate-infinite-scroll">
        <!-- Primer Grupo -->
        <div class="flex items-center justify-around gap-16 px-8 min-w-max">
            {logos.map((logo) => (
                <img
                    src={logo.src}
                    alt={logo.alt}
                    class={`${logo.class} object-contain grayscale-0 hover:grayscale transition-all duration-300 cursor-pointer opacity-90 hover:opacity-50`}
                />
            ))}
        </div>
        <!-- Segundo Grupo (Duplicado exacto) -->
        <div class="flex items-center justify-around gap-16 px-8 min-w-max">
            {logos.map((logo) => (
                <img
                    src={logo.src}
                    alt={logo.alt}
                    class={`${logo.class} object-contain grayscale-0 hover:grayscale transition-all duration-300 cursor-pointer opacity-90 hover:opacity-50`}
                />
            ))}
        </div>
        <!-- Tercer Grupo (Para asegurar el loop en pantallas grandes) -->
        <div class="flex items-center justify-around gap-16 px-8 min-w-max">
            {logos.map((logo) => (
                <img
                    src={logo.src}
                    alt={logo.alt}
                    class={`${logo.class} object-contain grayscale-0 hover:grayscale transition-all duration-300 cursor-pointer opacity-90 hover:opacity-50`}
                />
            ))}
        </div>
    </div>
</div>

<style>
    @keyframes scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(calc(-33.333333%)); }
    }
    .animate-infinite-scroll {
        animation: scroll 20s linear infinite;
    }
    .group\/carousel:hover .animate-infinite-scroll {
        animation-play-state: paused;
    }
</style>
