---
// Cabecera de páginas internas (catálogo, ChileValora, contacto...): franja
// angosta con fondo animado (mesh gradient + resplandor en movimiento sobre
// una malla técnica, ver .page-hero-mesh/.page-hero-glow en global.css).
// El validador usa el mismo lenguaje visual pero no puede importar este
// componente (es React, no Astro): ver Validador.jsx.
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div
    class="bg-[#050B14] pt-16 pb-11 md:pt-20 md:pb-14 relative overflow-hidden border-b border-white/10"
    style="clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), 50% 100%, 0 calc(100% - 20px));"
>
    {/* Malla técnica de fondo */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#22d3ee12_1px,transparent_1px),linear-gradient(to_bottom,#22d3ee12_1px,transparent_1px)] bg-[size:28px_28px]"></div>

    {/* Mesh gradient animado */}
    <div class="absolute inset-0 page-hero-mesh mix-blend-screen"></div>

    {/* Resplandor que se desplaza sobre la malla */}
    <div class="absolute -inset-1/2 page-hero-glow"></div>

    {/* Viñeta: asegura contraste del texto sobre el fondo animado */}
    <div class="absolute inset-0 bg-gradient-to-b from-[#050B14]/50 via-transparent to-[#050B14]"></div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
        <div class="max-w-2xl">
            <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-tight mb-2 text-glow">
                {title}
            </h1>
            {subtitle && (
                <p class="text-sm md:text-base text-cyan-100/80 font-medium leading-snug">
                    {subtitle}
                </p>
            )}
        </div>
    </div>
</div>
