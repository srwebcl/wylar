---
// Cabecera de páginas internas (catálogo, ChileValora, contacto): franja
// navy extremadamente baja — no un banner alto — con un barrido de luz que
// cruza el fondo en loop y una entrada escalonada del título/subtítulo al
// cargar (ver .hero-sweep/.hero-in-* en global.css). Tipografía y colores
// son los mismos del resto del sitio (Inter, navy/cian/ámbar). El validador
// usa el mismo lenguaje visual pero no puede importar este componente (es
// React, no Astro): ver Validador.jsx.
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="bg-[#050B14] py-5 md:py-6 relative overflow-hidden border-b border-white/10">
    {/* Barrido de luz en loop */}
    <div class="absolute inset-0 hero-sweep"></div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-5">
            <h1 class="hero-in-1 text-xl sm:text-2xl md:text-[28px] font-extrabold text-white tracking-tight leading-tight shrink-0">
                {title}
            </h1>
            {subtitle && (
                <>
                    <span class="hero-in-2 hidden sm:block w-px h-8 bg-white/15 shrink-0"></span>
                    <p class="hero-in-3 hidden sm:block text-sm text-white/65 leading-snug max-w-lg">
                        {subtitle}
                    </p>
                </>
            )}
        </div>
    </div>

    {/* Barra de acento — el mismo degradé de la franja superior del Header */}
    <div class="absolute bottom-0 left-0 right-0 h-[3px] bg-gradient-to-r from-blue-600 via-cyan-400 to-amber-500"></div>
</div>
