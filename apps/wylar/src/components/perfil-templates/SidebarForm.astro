---
// Formulario lateral de contacto, reutilizado por las 3 plantillas de ficha.
// Envía el lead directamente al CRM de Wylar (Módulo de Captura de Oportunidades).
const { icon: Icon, title = 'Solicitar Evaluación', ctaLabel = 'Cotizar este perfil', certificationInterest = '' } = Astro.props;
---

<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center shrink-0 text-amber-600">
            <Icon size={20} />
        </div>
        <h3 class="text-lg font-bold text-slate-900 leading-tight">{title}</h3>
    </div>

    <p class="text-slate-500 text-sm mb-5 font-medium">Déjanos tus datos y te enviaremos el temario y requisitos.</p>

    <form class="sidebar-lead-form space-y-4" data-certification-interest={certificationInterest}>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nombre completo</label>
            <input name="name" type="text" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="Su nombre" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Teléfono</label>
            <input name="phone" type="tel" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="+56 9 XXXXXXXX" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Correo</label>
            <input name="email" type="email" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="correo@ejemplo.com" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Modalidad</label>
            <select name="type" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all cursor-pointer text-[15px] font-medium text-slate-700" required>
                <option value="PERSONA">Soy persona</option>
                <option value="EMPRESA">Somos Empresa / Institución</option>
            </select>
        </div>

        <p class="sidebar-lead-feedback hidden text-sm font-medium rounded-lg p-3"></p>

        <button type="submit" class="sidebar-lead-submit w-full bg-[#0B1E40] hover:bg-blue-900 disabled:opacity-70 disabled:cursor-not-allowed text-white font-bold text-sm py-3 rounded-xl transition-colors flex items-center justify-center gap-2 mt-2 shadow-lg">
            <span class="sidebar-lead-submit-label">{ctaLabel}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
    </form>
</div>

<script>
    import { submitLead } from '../../lib/crm.js';

    document.querySelectorAll<HTMLFormElement>('form.sidebar-lead-form').forEach((form) => {
        const feedback = form.querySelector<HTMLParagraphElement>('.sidebar-lead-feedback');
        const submitBtn = form.querySelector<HTMLButtonElement>('.sidebar-lead-submit');
        const submitLabel = form.querySelector<HTMLSpanElement>('.sidebar-lead-submit-label');
        const defaultLabel = submitLabel?.textContent ?? '';
        if (!feedback || !submitBtn) return;

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = new FormData(form);
            if (data.get('website')) return; // honeypot

            feedback.classList.add('hidden');
            submitBtn.disabled = true;
            if (submitLabel) submitLabel.textContent = 'Enviando...';

            try {
                await submitLead({
                    type: data.get('type'),
                    name: data.get('name'),
                    email: data.get('email'),
                    phone: data.get('phone'),
                    certificationInterest: form.dataset.certificationInterest || null,
                });
                feedback.textContent = '¡Listo! Te contactaremos a la brevedad.';
                feedback.className = 'sidebar-lead-feedback text-sm font-medium rounded-lg p-3 bg-emerald-50 text-emerald-700 border border-emerald-200';
                form.reset();
            } catch (err) {
                feedback.textContent = err instanceof Error ? err.message : 'No pudimos enviar tu solicitud.';
                feedback.className = 'sidebar-lead-feedback text-sm font-medium rounded-lg p-3 bg-red-50 text-red-700 border border-red-200';
            } finally {
                submitBtn.disabled = false;
                if (submitLabel) submitLabel.textContent = defaultLabel;
            }
        });
    });
</script>
