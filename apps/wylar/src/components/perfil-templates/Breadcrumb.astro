---
// Wayfinding: cómo volver al catálogo sin usar el botón "atrás" del navegador.
const { title } = Astro.props;
---

<nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center flex-wrap gap-1.5 text-xs font-semibold text-slate-500">
        <li><a href="/" class="hover:text-blue-600 transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="text-slate-300">/</li>
        <li><a href="/catalogo" class="hover:text-blue-600 transition-colors">Certificaciones</a></li>
        <li aria-hidden="true" class="text-slate-300">/</li>
        <li class="text-slate-800 truncate max-w-[220px] sm:max-w-none" aria-current="page">{title}</li>
    </ol>
</nav>
