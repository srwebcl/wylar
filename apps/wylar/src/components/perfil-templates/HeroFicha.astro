---
// Hero recortado a lo esencial: título de la certificación + descripción
// precisa + datos clave (sector/nivel/vigencia) + CTA. El texto narrativo
// largo (heroHook/heroParagraphs) vive más abajo, en la columna de lectura
// sobre fondo claro — mucho más cómodo de leer que apilado en el Hero oscuro.
const {
    perfil,
    badgeLabel,
    ctaLabel,
    ctaIcon: CtaIcon,
    whatsapp = false,
} = Astro.props;

const facts = [
    { label: 'Sector', value: perfil.sector },
    { label: 'Subsector', value: perfil.subsector },
    { label: 'Nivel', value: perfil.nivel },
    ...(perfil.vigencia ? [{ label: 'Vigencia', value: perfil.vigencia }] : []),
];
---

<section class="relative bg-[#0B1E40] text-white overflow-hidden border-b-4 border-amber-500">
    <div class="absolute inset-0">
        <img src={perfil.image} alt={perfil.title} class="w-full h-full object-cover" />
    </div>
    {/* Scrim: lavado parejo + viñeta inferior en mobile (texto centrado, la foto
        se lee en todo el ancho); degradado izquierda→derecha en desktop, donde
        el texto queda alineado a la izquierda y la foto respira a la derecha. */}
    <div class="absolute inset-0 bg-[#0B1E40]/65 md:bg-gradient-to-r md:from-[#0B1E40] md:via-[#0B1E40]/90 md:to-[#0B1E40]/45"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#0B1E40] to-transparent md:hidden"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 md:py-20">
        <div class="max-w-2xl mx-auto md:mx-0 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm text-xs font-bold uppercase tracking-widest mb-5">
                <slot name="badge-icon" />
                {badgeLabel}
            </div>

            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4">
                {perfil.title}
            </h1>

            <p class="text-base md:text-lg text-slate-200 leading-relaxed font-medium mb-8 max-w-xl mx-auto md:mx-0">
                {perfil.description}
            </p>

            <div class="flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-3 mb-9 pb-9 border-b border-white/10">
                {facts.map((f) => (
                    <div>
                        <div class="text-[11px] font-bold text-slate-300 uppercase tracking-widest mb-0.5">{f.label}</div>
                        <div class="text-base font-bold text-white">{f.value}</div>
                    </div>
                ))}
            </div>

            <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-4">
                <button
                    type="button"
                    data-open-form
                    class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-sm uppercase tracking-widest px-7 py-3.5 rounded-xl transition-all shadow-lg shadow-blue-900/40"
                >
                    <CtaIcon size={18} /> {ctaLabel}
                </button>
                {whatsapp && (
                    <a
                        href="https://wa.me/56912345678"
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm uppercase tracking-widest px-7 py-3.5 rounded-xl transition-all backdrop-blur-sm"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.885 3.488A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" /></svg>
                        Contactar por WhatsApp
                    </a>
                )}
            </div>
        </div>
    </div>
</section>
