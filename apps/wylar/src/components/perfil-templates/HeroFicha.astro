---
const {
    perfil,
    badgeLabel,
    ctaLabel,
    ctaIcon: CtaIcon,
    whatsapp = false,
} = Astro.props;
---

<section class="relative bg-[#050B14] text-white overflow-hidden border-b-4 border-amber-500">
    <style>
        @keyframes kenBurnsSingle {
            0% { transform: scale(1); }
            100% { transform: scale(1.05); }
        }
        .ken-burns-hero {
            animation: kenBurnsSingle 10s ease-out forwards;
        }
    </style>

    {/* BACKGROUND LAYER (Ken Burns) */}
    <div class="absolute inset-0 overflow-hidden bg-[#050B14] pointer-events-none z-0">
        <div
            class="w-full h-full bg-cover bg-center md:bg-[80%_center] ken-burns-hero"
            style={`background-image: url('${perfil.image}')`}
        ></div>
    </div>

    {/* Scrim oscuro: emulando exactamente el Hero del Homepage */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#050B14] via-[#050B14]/80 sm:via-[#050B14]/65 to-[#050B14]/10 md:to-transparent z-10"></div>
    <div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-[#050B14] via-[#050B14]/60 to-transparent z-10"></div>

    {/* CONTENT LAYER */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 py-20 md:py-28">
        <div class="max-w-2xl mx-auto md:mx-0 text-center md:text-left">
            <div class="flex justify-center md:justify-start mb-6">
                <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] shadow-lg text-white text-sm font-bold tracking-wide border border-white/10">
                    <slot name="badge-icon" />
                    <span>{badgeLabel}</span>
                </div>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] mb-6 text-white">
                {perfil.title}
            </h1>

            <p class="text-base md:text-lg text-white/80 leading-relaxed font-medium mb-10 max-w-xl mx-auto md:mx-0">
                {perfil.description}
            </p>

            <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-4">
                <a
                    href="#contenido-perfil"
                    class="relative overflow-hidden group bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white px-8 py-3.5 rounded-full flex items-center justify-center gap-2.5 transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5 font-bold text-base uppercase tracking-widest"
                >
                    <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
                    <span class="relative z-10">¿Cómo Funciona?</span>
                </a>
                
                <button
                    type="button"
                    data-open-form
                    class="bg-white hover:bg-slate-50 border-2 border-white/10 hover:border-white/20 text-[#0B1E40] px-8 py-3.5 rounded-full font-bold text-base flex items-center justify-center gap-2.5 transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 uppercase tracking-widest"
                >
                    <CtaIcon size={20} /> 
                    <span>Solicitar Información</span>
                </button>
            </div>
        </div>
    </div>
</section>
