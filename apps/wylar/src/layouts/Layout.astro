---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
    description?: string;
    image?: string;
}

const { title, description = "Wylar - Centro de Evaluación y Certificación de Competencias Laborales", image } = Astro.props;
const currentPath = Astro.url.pathname;

// Imagen para compartir en redes: la propia del perfil/página si la pasaron
// (ej. la foto real de la certificación), si no el logo. Puede venir como
// ruta relativa (/images/...) o absoluta (Vercel Blob) — se normaliza a URL
// completa para que las redes sociales puedan cargarla.
const ogImage = image
    ? (image.startsWith('http') ? image : Astro.url.origin + image)
    : Astro.url.origin + '/images/logo.webp';

// Datos de la organización (mismos en todas las páginas): le dice a Google
// quién es Wylar — nombre, logo, contacto, acreditación — para resultados
// enriquecidos y el panel de conocimiento.
const organizationSchema = {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Wylar',
    legalName: 'Wylar Ltda.',
    url: 'https://www.wylar.cl',
    logo: 'https://www.wylar.cl/images/logo.webp',
    description: 'Centro de Evaluación y Certificación de Competencias Laborales acreditado por ChileValora.',
    address: [
        { '@type': 'PostalAddress', streetAddress: 'Río Blanco 1371, Barrio Industrial', addressLocality: 'Arica', addressCountry: 'CL' },
        { '@type': 'PostalAddress', streetAddress: "Av. Libertador Bernardo O'Higgins 252, oficina 21", addressLocality: 'Santiago', addressCountry: 'CL' },
    ],
    contactPoint: { '@type': 'ContactPoint', telephone: '+56-9-2956-6326', email: 'contacto@wylar.cl', contactType: 'customer service' },
    sameAs: [],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Wylar" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url.origin + Astro.url.pathname} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
	</head>
	<body class="min-h-screen bg-slate-50 font-sans text-slate-800 flex flex-col relative overflow-x-hidden">
        <Header client:load currentPath={currentPath} />
		<main class="flex-grow">
			<slot />
		</main>
        <Footer />
	</body>
</html>
