---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.jsx';
import { Phone, Mail, MapPin, ArrowRight, ArrowUpRight } from 'lucide-react';
---

<Layout title="Contacto | Wylar">
    <div class="animate-in fade-in duration-500 bg-white">
        <PageHero
            title="Ponte en contacto con nosotros"
            subtitle="Estamos aquí para resolver tus dudas, guiarte en el proceso o coordinar una alianza estratégica."
        />

    {/* Formulario */}
    <ContactForm client:load hideHeader={true} />

    {/* Datos de contacto adicionales: una ficha de directorio, no 4 tarjetas
        idénticas — separa lo que se resuelve al toque (teléfono/correo) de
        las sedes físicas, y distingue casa matriz de sucursal (misma
        jerarquía real que ya usa el Footer). */}
    <section class="py-16 md:py-20 bg-slate-50 border-t border-slate-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-slate-200">

                {/* Contacto directo */}
                <div class="md:pr-12">
                    <h2 class="text-base font-bold text-[#0B1E40] mb-4">Contacto directo</h2>
                    <div class="border-t border-b border-slate-200 divide-y divide-slate-200">
                        <a href="tel:+56929566326" class="group flex items-center gap-4 py-4">
                            <Phone size={18} className="text-slate-400 group-hover:text-blue-600 transition-colors shrink-0" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Teléfono</p>
                                <p class="text-base font-semibold text-[#0B1E40] group-hover:text-blue-700 transition-colors">+56 9 2956 6326</p>
                            </div>
                            <ArrowRight size={16} className="text-slate-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0" />
                        </a>
                        <a href="mailto:contacto@wylar.cl" class="group flex items-center gap-4 py-4">
                            <Mail size={18} className="text-slate-400 group-hover:text-blue-600 transition-colors shrink-0" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Correo</p>
                                <p class="text-base font-semibold text-[#0B1E40] group-hover:text-blue-700 transition-colors truncate">contacto@wylar.cl</p>
                            </div>
                            <ArrowRight size={16} className="text-slate-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0" />
                        </a>
                    </div>
                </div>

                {/* Nuestras sedes */}
                <div class="md:pl-12">
                    <h2 class="text-base font-bold text-[#0B1E40] mb-4">Nuestras sedes</h2>
                    <div class="border-t border-b border-slate-200 divide-y divide-slate-200">
                        <a href="https://maps.google.com/?q=Rio+Blanco+1371+Barrio+Industrial+Arica" target="_blank" rel="noreferrer" class="group flex items-start gap-4 py-4">
                            <MapPin size={18} className="text-slate-400 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Casa Matriz Arica</p>
                                <p class="text-base font-semibold text-[#0B1E40] leading-snug">Río Blanco 1371, Barrio Industrial</p>
                            </div>
                            <ArrowUpRight size={16} className="text-slate-300 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                        </a>
                        <a href="https://maps.google.com/?q=Av.+Libertador+Bernardo+O'Higgins+252+oficina+21+Santiago" target="_blank" rel="noreferrer" class="group flex items-start gap-4 py-4">
                            <MapPin size={18} className="text-slate-400 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Sucursal Santiago</p>
                                <p class="text-base font-semibold text-[#0B1E40] leading-snug">Av. Libertador Bernardo O'Higgins 252, oficina 21</p>
                            </div>
                            <ArrowUpRight size={16} className="text-slate-300 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>
    </div>
</Layout>
