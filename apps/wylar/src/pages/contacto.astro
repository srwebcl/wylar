---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.jsx';
---

<Layout title="Contacto | Wylar">
    <div class="animate-in fade-in duration-500 bg-white">
        <PageHero
            title="Ponte en contacto con nosotros"
            subtitle="Estamos aquí para resolver tus dudas, guiarte en el proceso o coordinar una alianza estratégica."
        />

    {/* Formulario */}
    <ContactForm client:load hideHeader={true} />

    {/* Datos de contacto adicionales (Minimalista Interactivo) */}
    <section class="py-16 md:py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                
                {/* Atención Telefónica */}
                <div class="flex flex-col group bg-white rounded-3xl p-8 border border-transparent hover:border-slate-100 hover:shadow-2xl hover:shadow-blue-900/5 hover:-translate-y-2 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center mb-6 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 block">
                        Atención Telefónica
                    </span>
                    <p class="text-lg font-medium text-[#0B1E40] tracking-tight mb-8 leading-relaxed group-hover:text-blue-600 transition-colors">
                        +56 9 2956 6326
                    </p>
                    <div class="mt-auto">
                        <a href="tel:+56929566326" class="inline-flex items-center justify-center gap-2 px-6 py-3 w-full rounded-full bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg">
                            Llamar ahora
                        </a>
                    </div>
                </div>

                {/* Correo Electrónico */}
                <div class="flex flex-col group bg-white rounded-3xl p-8 border border-transparent hover:border-slate-100 hover:shadow-2xl hover:shadow-blue-900/5 hover:-translate-y-2 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center mb-6 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 block">
                        Correo Electrónico
                    </span>
                    <p class="text-lg font-medium text-[#0B1E40] tracking-tight mb-8 leading-relaxed group-hover:text-blue-600 transition-colors truncate">
                        contacto@wylar.cl
                    </p>
                    <div class="mt-auto">
                        <a href="mailto:contacto@wylar.cl" class="inline-flex items-center justify-center gap-2 px-6 py-3 w-full rounded-full bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg">
                            Enviar mensaje
                        </a>
                    </div>
                </div>

                {/* Sede Santiago */}
                <div class="flex flex-col group bg-white rounded-3xl p-8 border border-transparent hover:border-slate-100 hover:shadow-2xl hover:shadow-amber-900/5 hover:-translate-y-2 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center mb-6 group-hover:bg-amber-50 group-hover:text-amber-500 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 block">
                        Sede Santiago
                    </span>
                    <p class="text-lg font-medium text-[#0B1E40] tracking-tight mb-8 leading-relaxed group-hover:text-slate-900 transition-colors">
                        Av. Libertador Bernardo O'Higgins 252<br/>oficina 21, Santiago Metro UC.
                    </p>
                    <div class="mt-auto">
                        <a href="https://maps.google.com/?q=Av.+Libertador+Bernardo+O'Higgins+252+oficina+21+Santiago" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 w-full rounded-full bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg">
                            Ver en mapa
                        </a>
                    </div>
                </div>

                {/* Casa Matriz Arica */}
                <div class="flex flex-col group bg-white rounded-3xl p-8 border border-transparent hover:border-slate-100 hover:shadow-2xl hover:shadow-amber-900/5 hover:-translate-y-2 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center mb-6 group-hover:bg-amber-50 group-hover:text-amber-500 transition-colors duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 block">
                        Casa Matriz Arica
                    </span>
                    <p class="text-lg font-medium text-[#0B1E40] tracking-tight mb-8 leading-relaxed group-hover:text-slate-900 transition-colors">
                        Río Blanco 1371<br/>Barrio Industrial, Arica.
                    </p>
                    <div class="mt-auto">
                        <a href="https://maps.google.com/?q=Rio+Blanco+1371+Barrio+Industrial+Arica" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 w-full rounded-full bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm transition-all shadow-md hover:shadow-lg">
                            Ver en mapa
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </section>
    </div>
</Layout>
