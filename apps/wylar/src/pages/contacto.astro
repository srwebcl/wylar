---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.jsx';
import { Mail, MapPin, ArrowRight, ArrowUpRight } from 'lucide-react';
---

<Layout
    title="Contacto | Wylar"
    description="Contáctanos para resolver tus dudas, cotizar una evaluación o coordinar una alianza con Wylar, Centro de Evaluación y Certificación acreditado por ChileValora."
>
    <div class="animate-in fade-in duration-500 bg-white">
        <PageHero
            title="Ponte en contacto con nosotros"
            subtitle="Estamos aquí para resolver tus dudas, guiarte en el proceso o coordinar una alianza estratégica."
        />

    {/* Formulario */}
    <ContactForm client:load hideHeader={true} />

    {/* Datos de contacto adicionales: una ficha de directorio, no 4 tarjetas
        idénticas — separa lo que se resuelve al toque (teléfono/correo) de
        las sedes físicas, y distingue casa matriz de sucursal (misma
        jerarquía real que ya usa el Footer). */}
    <section class="py-16 md:py-20 bg-slate-50 border-t border-slate-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-0 md:divide-x md:divide-slate-200">

                {/* Contacto directo */}
                <div class="md:pr-12">
                    <h2 class="text-base font-bold text-[#0B1E40] mb-4">Contacto directo</h2>
                    <div class="border-t border-b border-slate-200 divide-y divide-slate-200">
                        <a href="https://wa.me/56929566326" target="_blank" rel="noreferrer" class="group flex items-center gap-4 py-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-slate-400 group-hover:text-emerald-500 transition-colors shrink-0">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                            </svg>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">WhatsApp</p>
                                <p class="text-base font-semibold text-[#0B1E40] group-hover:text-emerald-600 transition-colors">+56 9 2956 6326</p>
                            </div>
                            <ArrowRight size={16} className="text-slate-300 group-hover:text-emerald-500 group-hover:translate-x-0.5 transition-all shrink-0" />
                        </a>
                        <a href="mailto:contacto@wylar.cl" class="group flex items-center gap-4 py-4">
                            <Mail size={18} className="text-slate-400 group-hover:text-blue-600 transition-colors shrink-0" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Correo</p>
                                <p class="text-base font-semibold text-[#0B1E40] group-hover:text-blue-700 transition-colors truncate">contacto@wylar.cl</p>
                            </div>
                            <ArrowRight size={16} className="text-slate-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all shrink-0" />
                        </a>
                    </div>
                </div>

                {/* Nuestras sedes */}
                <div class="md:pl-12">
                    <h2 class="text-base font-bold text-[#0B1E40] mb-4">Nuestras sedes</h2>
                    <div class="border-t border-b border-slate-200 divide-y divide-slate-200">
                        <a href="https://maps.google.com/?q=Rio+Blanco+1371+Barrio+Industrial+Arica" target="_blank" rel="noreferrer" class="group flex items-start gap-4 py-4">
                            <MapPin size={18} className="text-slate-400 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Casa Matriz Arica</p>
                                <p class="text-base font-semibold text-[#0B1E40] leading-snug">Río Blanco 1371, Barrio Industrial</p>
                            </div>
                            <ArrowUpRight size={16} className="text-slate-300 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                        </a>
                        <a href="https://maps.google.com/?q=Av.+Libertador+Bernardo+O'Higgins+252+oficina+21+Santiago" target="_blank" rel="noreferrer" class="group flex items-start gap-4 py-4">
                            <MapPin size={18} className="text-slate-400 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-slate-500 mb-0.5">Sucursal Santiago</p>
                                <p class="text-base font-semibold text-[#0B1E40] leading-snug">Av. Libertador Bernardo O'Higgins 252, oficina 21</p>
                            </div>
                            <ArrowUpRight size={16} className="text-slate-300 group-hover:text-amber-500 transition-colors shrink-0 mt-0.5" />
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>
    </div>
</Layout>
