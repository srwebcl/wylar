---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.jsx";
import CatalogoPerfiles from "../components/CatalogoPerfiles.jsx";
import { getCatalogList } from "../lib/catalog.js";
import {
  Handshake,
  MapPin,
  FileCheck,
  Award,
  ArrowDown,
  ArrowRight,
  Presentation,
  CheckCircle2,
  Layers,
} from "lucide-react";

const PROGRAMAS = [
  "Becas Laborales",
  "Reinvéntate",
  "Capacitación en Oficios / Fórmate para el Trabajo",
  "Proyecto +R (Reinserción)",
];

const perfiles = await getCatalogList();
---

<Layout title="Alianzas para OTEC | Wylar">
  <div class="animate-in fade-in duration-700 bg-slate-50 overflow-hidden">
    {/* HERO */}
    <section
      id="inicio"
      class="relative min-h-[75vh] md:min-h-[85vh] lg:min-h-[90vh] flex items-center bg-[#050B14] overflow-hidden border-b border-white/10"
    >
      <div class="absolute inset-0 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=2070&auto=format&fit=crop"
          alt="Charla de capacitación técnica"
          class="w-full h-full object-cover animate-[kenBurns_30s_ease-in-out_infinite_alternate]"
        />
      </div>
      <div class="absolute inset-0 bg-[#0B1E40]/80"></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#050B14] via-transparent to-[#050B14]/50"
      >
      </div>

      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-24"
      >
        <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] text-white shadow-xl mb-8 border border-white/10"
          >
            <Handshake size={16} className="text-cyan-400" />
            <span class="text-xs font-bold uppercase tracking-widest"
              >Portal OTEC</span
            >
          </div>

          <h1
            class="text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.15] mb-4 sm:mb-6 text-white"
          >
            Un aliado estratégico para sus certificaciones
          </h1>

          <p
            class="text-base md:text-lg text-white/80 mb-6 sm:mb-8 md:mb-12 leading-relaxed max-w-xl mx-auto"
          >
            En WYLAR nos aliamos con su OTEC para llevar a cabo las certificaciones de sus estudiantes.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <a
              href="#seccion-2"
              class="bg-white hover:bg-slate-50 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 group"
            >
              DESCUBRE CÓMO FUNCIONA <ArrowDown size={18} class="group-hover:translate-y-1 transition-transform" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* SECCIÓN 2: INTRO Y FEATURES */}
    <section id="seccion-2" class="bg-white py-24 md:py-32 relative overflow-hidden border-b border-slate-100">
      {/* Elementos decorativos sutiles */}
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-bl from-blue-50/50 to-transparent rounded-full blur-3xl -z-10 translate-x-1/3 -translate-y-1/3"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-cyan-50/50 to-transparent rounded-full blur-3xl -z-10 -translate-x-1/3 translate-y-1/3"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Fila 1: Textos */}
        <div class="max-w-4xl mx-auto text-center mb-20 scroll-fade-up opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 text-blue-700 font-bold text-sm tracking-widest uppercase mb-8">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            Nuestra Experiencia
          </div>
          
          <h2 class="text-4xl md:text-5xl font-extrabold text-[#0B1E40] leading-[1.15] mb-8">
            La certificación de los participantes es <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">fundamental</span>
          </h2>
          
          <p class="text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-16">
            En WYLAR entendemos la importancia de este proceso para una OTEC. Por eso, ponemos nuestra experiencia a disposición para coordinar y ejecutar procesos de certificación de manera clara, ordenada y oportuna, adaptándonos a las necesidades de cada curso, programa y territorio.
          </p>
          
          <div class="relative inline-block text-left">
            <span class="absolute -top-6 -left-8 text-8xl text-blue-100 font-serif leading-none select-none -z-10">"</span>
            <p class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] leading-snug">
              Usted ejecuta la <span class="text-blue-600">capacitación</span>.<br />
              Nosotros nos hacemos cargo de coordinar la <span class="text-cyan-500">certificación</span>.
            </p>
          </div>
        </div>

        {/* Fila 2: Features Uniformes */}
        <div class="grid md:grid-cols-3 gap-8 relative z-10">
          {/* Card 1 */}
          <div class="scroll-fade-up opacity-0 translate-y-8 transition-all duration-1000 ease-out delay-[200ms]">
            <div class="bg-[#0B1E40] p-10 rounded-[2rem] h-full flex flex-col items-start border border-[#163065] shadow-2xl shadow-blue-900/20 hover:-translate-y-2 transition-transform duration-300 group">
              <div class="w-16 h-16 bg-[#163065] text-cyan-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-cyan-400 group-hover:text-[#0B1E40] transition-all duration-300">
                <Layers size={32} />
              </div>
              <h4 class="font-bold text-2xl text-white mb-4">Procesos Claros</h4>
              <p class="text-blue-100/80 leading-relaxed text-lg">Ejecución ordenada y oportuna, simplificando la gestión operativa para su OTEC.</p>
            </div>
          </div>

          {/* Card 2 */}
          <div class="scroll-fade-up opacity-0 translate-y-8 transition-all duration-1000 ease-out delay-[400ms]">
            <div class="bg-[#0B1E40] p-10 rounded-[2rem] h-full flex flex-col items-start border border-[#163065] shadow-2xl shadow-blue-900/20 hover:-translate-y-2 transition-transform duration-300 group">
              <div class="w-16 h-16 bg-[#163065] text-cyan-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-cyan-400 group-hover:text-[#0B1E40] transition-all duration-300">
                <MapPin size={32} />
              </div>
              <h4 class="font-bold text-2xl text-white mb-4">Adaptabilidad</h4>
              <p class="text-blue-100/80 leading-relaxed text-lg">Nos adaptamos a cada curso, programa y a las particularidades de cada territorio.</p>
            </div>
          </div>

          {/* Card 3 */}
          <div class="scroll-fade-up opacity-0 translate-y-8 transition-all duration-1000 ease-out delay-[600ms]">
            <div class="bg-[#0B1E40] p-10 rounded-[2rem] h-full flex flex-col items-start border border-[#163065] shadow-2xl shadow-blue-900/20 hover:-translate-y-2 transition-transform duration-300 group">
              <div class="w-16 h-16 bg-[#163065] text-cyan-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-cyan-400 group-hover:text-[#0B1E40] transition-all duration-300">
                <Handshake size={32} />
              </div>
              <h4 class="font-bold text-2xl text-white mb-4">Trabajo Conjunto</h4>
              <p class="text-blue-100/80 leading-relaxed text-lg">Nos hacemos cargo de la certificación para que usted concentre su energía en capacitar.</p>
            </div>
          </div>
        </div>
      </div>

      <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.remove('opacity-0', 'translate-y-8');
                    entry.target.classList.add('opacity-100', 'translate-y-0');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });
        
        document.querySelectorAll('.scroll-fade-up').forEach(el => observer.observe(el));
      </script>

      <style>
        @keyframes marqueeUp {
          0% { transform: translateY(0%); }
          100% { transform: translateY(-50%); }
        }
        @keyframes kenBurns {
          0% { transform: scale(1); }
          100% { transform: scale(1.12); }
        }
      </style>
    </section>

    {/* CÓMO FUNCIONA */}
    <div id="proceso" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center mb-16 relative">
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-100 rounded-full blur-[80px] -z-10"
        >
        </div>
        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6">
          Un proceso coordinado de principio a fin
        </h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Coordinamos cada proceso de acuerdo con las fechas y requerimientos
          definidos, buscando que la certificación se integre de manera fluida a
          su proceso de capacitación.
        </p>
      </div>

      <div
        class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-[2rem] border border-slate-100 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.05)]"
      >
        <h3 class="text-2xl font-bold text-[#0B1E40] mb-8 text-center">
          Nuestro trabajo considera:
        </h3>

        <div class="space-y-6">
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 mt-1"
            >
              <Layers size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg text-slate-900">
                Coordinación previa con el OTEC
              </h4>
            </div>
          </div>
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 mt-1"
            >
              <CheckCircle2 size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg text-slate-900">
                Planificación de las fechas de evaluación
              </h4>
            </div>
          </div>
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 mt-1"
            >
              <MapPin size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg text-slate-900">
                Ejecución de las evaluaciones en el lugar donde se desarrolla la
                capacitación
              </h4>
            </div>
          </div>
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 mt-1"
            >
              <FileCheck size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg text-slate-900">
                Entrega de información clara a los participantes candidatos a
                certificación
              </h4>
            </div>
          </div>
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 mt-1"
            >
              <Presentation size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg text-slate-900">
                Charlas informativas
              </h4>
              <p class="text-slate-600 mt-1 leading-relaxed">
                Para que los participantes conozcan el proceso, comprendan sus
                etapas y puedan resolver sus dudas antes de la evaluación.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* BENEFICIOS */}
    <section id="beneficios" class="bg-white py-24 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="w-full lg:w-1/2">
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-bold tracking-widest uppercase mb-6"
            >
              <Handshake size={16} /> Aliado Estratégico
            </div>
            <h2
              class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-8 leading-tight"
            >
              Entendemos sus <span class="text-blue-600"
                >programas y territorios.</span
              >
            </h2>
            <div class="space-y-6">
              <div class="flex gap-5">
                <div
                  class="bg-blue-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-blue-600"
                >
                  <FileCheck size={24} />
                </div>
                <div>
                  <h4 class="font-bold text-xl text-slate-900 mb-3">
                    Nos adaptamos a sus programas
                  </h4>
                  <p class="text-slate-600 leading-relaxed mb-3">
                    Conocemos y comprendemos los procesos asociados a distintos
                    programas de capacitación, entre ellos:
                  </p>
                  <ul class="grid sm:grid-cols-2 gap-2">
                    {
                      PROGRAMAS.map((p) => (
                        <li class="flex items-start gap-2 text-sm text-slate-600">
                          <CheckCircle2
                            size={14}
                            className="text-blue-500 mt-1 shrink-0"
                          />{" "}
                          {p}
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
              <div class="flex gap-5">
                <div
                  class="bg-cyan-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-cyan-600"
                >
                  <Award size={24} />
                </div>
                <div>
                  <h4 class="font-bold text-xl text-slate-900 mb-2">
                    ¿Necesita certificar un perfil específico?
                  </h4>
                  <p class="text-slate-600 leading-relaxed">
                    Si necesita certificar un perfil que no se encuentra dentro
                    de nuestra oferta habitual, consúltenos. Analizaremos su
                    requerimiento y las alternativas disponibles para gestionar
                    el proceso que necesita.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="w-full lg:w-1/2 relative">
            <div
              class="absolute inset-0 bg-gradient-to-br from-blue-600 to-cyan-400 rounded-3xl transform rotate-3 scale-105 opacity-20 blur-lg"
            >
            </div>
            <img
              src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=2070&auto=format&fit=crop"
              alt="Charla de capacitación técnica"
              class="relative rounded-3xl shadow-2xl object-cover h-[500px] w-full"
            />
            <div
              class="absolute -bottom-8 -left-8 bg-white p-6 rounded-2xl shadow-xl border border-slate-100 flex items-center gap-4"
            >
              <div class="bg-green-100 text-green-600 p-3 rounded-full">
                <MapPin size={24} />
              </div>
              <div>
                <div class="font-black text-xl text-slate-900">En Terreno</div>
                <div class="text-sm font-medium text-slate-500">
                  Donde se dicte su curso
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CATÁLOGO DE PERFILES */}
    <div id="perfiles">
      <CatalogoPerfiles
        client:load
        perfiles={perfiles}
        title="Perfiles para sus Participantes"
        subtitle="Estas son las certificaciones que puede coordinar para los participantes de sus cursos y programas."
      />
    </div>

    {/* FORMULARIO */}
    <ContactForm
      client:idle
      title="Queremos Apoyar su Proceso"
      subtitle="Cuéntenos sus necesidades puntuales y busquemos juntos la mejor forma de llevar adelante su proceso de certificación. ¿Tiene un curso que necesita certificar? Solicite una cotización."
      preselectedContext="otec"
    />
  </div>
</Layout>
