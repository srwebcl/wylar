---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CatalogoInteractivo from '../components/CatalogoInteractivo.jsx';
import ContactForm from '../components/ContactForm.jsx';
import { getCatalogList } from '../lib/catalog.js';
import { setCdnCache } from '../lib/cache.js';

const perfiles = await getCatalogList();
setCdnCache(Astro, perfiles.length > 0);
---

<Layout
    title="Certificaciones | Wylar"
    description="Explora el catálogo de certificaciones de Wylar: perfiles ChileValora y certificaciones privadas para electricistas, riggers, soldadores, cuidadores y más."
>
    <div class="animate-in fade-in duration-500 bg-slate-50">

        <PageHero
            title="Catálogo de certificaciones"
            subtitle="Explora nuestra biblioteca de perfiles de ChileValora y certificaciones privadas."
        />

        {/* COMPONENTE INTERACTIVO */}
        <CatalogoInteractivo client:load perfiles={perfiles} />
        
        {/* FORMULARIO */}
        <ContactForm 
            client:idle
            title="Cotiza tu evaluación" 
            subtitle="Si ya sabes qué perfil te interesa, escríbenos para iniciar el proceso." 
            preselectedContext=""
        />
    </div>
</Layout>
