---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import CatalogoPerfiles from '../components/CatalogoPerfiles.jsx';
import { Users, FileCheck, Award, ArrowDown, ArrowRight, ShieldCheck, CheckCircle2, Compass } from 'lucide-react';
---

<Layout title="Certificación para Personas | Wylar">
    <div class="animate-in fade-in duration-700 bg-slate-50 overflow-hidden">

        {/* HERO */}
        <section id="inicio" class="relative min-h-[60vh] md:min-h-[65vh] flex items-center bg-[#050B14] overflow-hidden border-b border-white/10">
            <div class="absolute inset-0">
                <img src="/images/hero_principal.jpg" alt="Trabajadores certificados por Wylar" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-[#0B1E40]/80"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#050B14] via-transparent to-[#050B14]/50"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-24">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] text-white shadow-xl mb-8 border border-white/10">
                        <Users size={16} className="text-cyan-400" />
                        <span class="text-xs font-bold uppercase tracking-widest">Portal Personas</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6 text-white">
                        ¿Tienes experiencia? <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-cyan-300">Certifica lo que sabes hacer.</span>
                    </h1>

                    <p class="text-lg md:text-xl text-white/80 leading-relaxed font-medium max-w-3xl mb-4">
                        Has aprendido trabajando, practicando y desarrollando tu oficio a lo largo de los años. Todo ese conocimiento y experiencia tienen valor. Haz que sean reconocidos.
                    </p>
                    <p class="text-base md:text-lg text-cyan-200 font-bold leading-relaxed max-w-3xl mb-10">
                        En WYLAR te ayudamos a demostrar formalmente tus competencias, mediante Certificaciones ChileValora o Certificaciones y Calificaciones Privadas.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center gap-4">
                        <a href="#contacto" class="bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2">
                            Iniciar Proceso <ArrowRight size={18} />
                        </a>
                        <a href="#proceso" class="bg-white hover:bg-slate-50 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                            Ver cómo funciona <ArrowDown size={18} />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* MÉTRICAS */}
        <section class="bg-white py-24 border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 divide-y md:divide-y-0 md:divide-x divide-slate-200 text-center">
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">+5.000</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Certificados Emitidos</div>
                    </div>
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">Nacional</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Validez del Certificado</div>
                    </div>
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">3 Pasos</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Proceso Simple y Claro</div>
                    </div>
                </div>
            </div>
        </section>

        {/* CÓMO FUNCIONA / QUÉ CERTIFICAR */}
        <div id="proceso" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
            <div class="flex flex-col lg:flex-row gap-12 max-w-6xl mx-auto">
                <div class="w-full lg:w-1/2 bg-white p-10 rounded-[2rem] border border-slate-100 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.05)]">
                    <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-6">
                        <ShieldCheck size={32} />
                    </div>
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-6">¿Qué puedes certificar?</h2>
                    <p class="text-slate-600 leading-relaxed mb-4">
                        Contamos con alternativas para diferentes oficios y especialidades.
                    </p>
                    <p class="text-slate-600 leading-relaxed">
                        Puedes acceder a una <strong>Certificación de Competencias Laborales ChileValora</strong> cuando existe un perfil ocupacional aplicable, o a una <strong>Certificación o Calificación Privada</strong> para acreditar determinadas competencias y especialidades, como soldadura, rigger, maquinaria y otros oficios.
                    </p>
                </div>

                <div class="w-full lg:w-1/2 bg-gradient-to-br from-blue-600 to-[#0B1E40] p-10 rounded-[2rem] shadow-[0_20px_50px_-10px_rgba(11,30,64,0.4)] text-white relative overflow-hidden">
                    <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
                    <div class="w-16 h-16 bg-white/10 backdrop-blur-sm border border-white/20 text-white rounded-2xl flex items-center justify-center mb-6 relative z-10">
                        <Compass size={32} />
                    </div>
                    <h2 class="text-3xl font-extrabold text-white mb-6 relative z-10">¿Cuál es la certificación adecuada para ti?</h2>
                    <p class="text-blue-100 leading-relaxed mb-4 font-medium relative z-10">
                        No necesitas saberlo antes de contactarnos. Nosotros te orientamos.
                    </p>
                    <p class="text-blue-100 leading-relaxed relative z-10">
                        Cuéntanos qué haces, qué experiencia tienes y para qué necesitas certificarte. Revisaremos tu caso y te explicaremos de manera clara qué puedes certificar, qué alternativa es la más adecuada y cómo comenzar.
                    </p>
                </div>
            </div>
        </div>

        {/* BENEFICIOS */}
        <section id="beneficios" class="bg-white py-24 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col lg:flex-row gap-16 items-center">
                    <div class="w-full lg:w-1/2">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-bold tracking-widest uppercase mb-6">
                            <Award size={16} /> Impulso Laboral
                        </div>
                        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-8 leading-tight">
                            No se trata de decirlo. <span class="text-blue-600">Se trata de demostrarlo.</span>
                        </h2>
                        <div class="space-y-6">
                            <div class="flex gap-5">
                                <div class="bg-blue-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-blue-600">
                                    <ShieldCheck size={24} />
                                </div>
                                <div>
                                    <h4 class="font-bold text-xl text-slate-900 mb-2">Una certificación puede marcar la diferencia</h4>
                                    <p class="text-slate-600 leading-relaxed">Contar con un respaldo formal de tus competencias te permite fortalecer tu perfil laboral, demostrar lo que sabes hacer y presentarte con mayor respaldo ante empresas y empleadores.</p>
                                </div>
                            </div>
                            <div class="flex gap-5">
                                <div class="bg-cyan-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-cyan-600">
                                    <Award size={24} />
                                </div>
                                <div>
                                    <h4 class="font-bold text-xl text-slate-900 mb-2">Tu experiencia puede abrirte nuevas oportunidades</h4>
                                    <p class="text-slate-600 leading-relaxed">Una certificación respalda tu trayectoria y demuestra tus capacidades cuando una empresa necesita comprobar que sabes desempeñarte en una determinada actividad. Tu experiencia no debería quedarse solo en tus palabras.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 relative">
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-600 to-cyan-400 rounded-3xl transform rotate-3 scale-105 opacity-20 blur-lg"></div>
                        <img src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?q=80&w=2070&auto=format&fit=crop" alt="Trabajador industrial" class="relative rounded-3xl shadow-2xl object-cover h-[500px] w-full" />
                        <div class="absolute -bottom-8 -left-8 bg-white p-6 rounded-2xl shadow-xl border border-slate-100 flex items-center gap-4">
                            <div class="bg-green-100 text-green-600 p-3 rounded-full"><CheckCircle2 size={24} /></div>
                            <div>
                                <div class="font-black text-xl text-slate-900">Validado</div>
                                <div class="text-sm font-medium text-slate-500">Nivel Nacional</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* CATÁLOGO DE PERFILES */}
        <div id="perfiles">
            <CatalogoPerfiles client:load title="Perfiles de Evaluación" subtitle="Selecciona el área en la que deseas certificarte para iniciar el proceso de postulación." />
        </div>

        {/* FORMULARIO */}
        <ContactForm
            client:idle
            title="Da el Siguiente Paso"
            subtitle="Si tienes experiencia en un oficio o especialidad y quieres certificar lo que sabes hacer, conversemos. Te orientamos, revisamos tu situación y te acompañamos durante el proceso."
            preselectedContext=""
        />
    </div>
</Layout>
