---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import CatalogoPerfiles from '../components/CatalogoPerfiles.jsx';
import { getCatalogList } from '../lib/catalog.js';
import {
  Users,
  ArrowDown,
  ArrowRight,
  BadgeCheck,
  Layers,
  HelpCircle,
  Quote,
  MessageCircle,
  Search,
  Compass,
  ShieldCheck,
  TrendingUp,
  Star,
} from 'lucide-react';

const HERO_IMG = '/images/hero_principal.jpg';

const SERVICIO = [
  { icon: BadgeCheck, title: 'Certificación ChileValora', text: 'Cuando existe un perfil ocupacional aplicable, puedes acceder a una Certificación de Competencias Laborales.' },
  { icon: Layers, title: 'Certificación o Calificación Privada', text: 'Una alternativa para acreditar determinadas competencias y especialidades, como soldadura, rigger, maquinaria y otros oficios.' },
  { icon: HelpCircle, title: 'No necesitas saber cuál elegir', text: 'Cuéntanos qué haces, qué experiencia tienes y para qué necesitas certificarte. Nosotros te orientamos.' },
];

const ORIENTACION_PASOS = [
  { title: 'Cuéntanos tu experiencia', text: 'Explícanos qué haces, en qué oficio o especialidad tienes experiencia y qué necesitas acreditar.' },
  { title: 'Revisamos tu situación', text: 'Analizamos tu caso y las alternativas disponibles para tu experiencia y especialidad.' },
  { title: 'Te explicamos cómo comenzar', text: 'Recibirás orientación clara sobre la alternativa de certificación y los siguientes pasos.' },
];

const CONSIDERACIONES = [
  { icon: Search, title: 'Experiencia laboral', text: 'Tu trayectoria y conocimientos pueden ser la base para demostrar tus competencias.', accent: 'from-cyan-400 to-blue-500' },
  { icon: Layers, title: 'Oficios y especialidades', text: 'Existen alternativas para diferentes oficios y especialidades.', accent: 'from-blue-500 to-blue-700' },
  { icon: Compass, title: 'Orientación antes de iniciar', text: 'No necesitas conocer previamente qué certificación corresponde a tu caso.', accent: 'from-blue-700 to-[#0B1E40]' },
];

const VALOR = [
  { icon: ShieldCheck, title: 'Respalda tu experiencia', text: 'Obtén un reconocimiento formal de las competencias que has desarrollado.' },
  { icon: TrendingUp, title: 'Fortalece tu perfil laboral', text: 'Cuenta con un respaldo adicional para presentar tu experiencia y capacidades.' },
  { icon: Star, title: 'Demuestra lo que sabes hacer', text: 'Haz que tu experiencia tenga un respaldo más allá de tus propias palabras.' },
];

const perfiles = await getCatalogList();
---

<Layout title="Certificación para Personas | Wylar">
    <div class="animate-in fade-in duration-700 bg-slate-50">

        {/* HERO */}
        <section id="inicio" class="relative min-h-[60vh] md:min-h-[65vh] flex items-center bg-[#050B14] overflow-hidden border-b border-white/10">
            <div class="absolute inset-0">
                <img src={HERO_IMG} alt="Trabajadores certificados por Wylar" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-[#0B1E40]/80"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#050B14] via-transparent to-[#050B14]/50"></div>
            <div class="absolute top-0 right-0 w-[32rem] h-[32rem] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-24">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2.5 pl-2.5 pr-4 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] text-white shadow-xl mb-8 border border-white/10">
                        <span class="w-6 h-6 rounded-full bg-cyan-400/20 flex items-center justify-center shrink-0">
                            <Users size={13} className="text-cyan-300" />
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest">Certificación para personas</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6 text-white">
                        ¿Tienes experiencia? <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-blue-300">Certifica lo que sabes hacer.</span>
                    </h1>

                    <p class="text-lg md:text-xl text-white/80 leading-relaxed font-medium max-w-3xl mb-10">
                        Has aprendido trabajando, practicando y desarrollando tu oficio a lo largo de los años. Todo ese conocimiento y experiencia tienen valor. Haz que sean reconocidos.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center gap-4">
                        <a href="#contacto" class="group bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg shadow-blue-950/40 flex items-center justify-center gap-2">
                            Quiero certificarme <ArrowRight size={18} className="transition-transform group-hover:translate-x-1" />
                        </a>
                        <a href="#servicio" class="group bg-white hover:bg-slate-50 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                            Conocer mis opciones <ArrowDown size={18} className="transition-transform group-hover:translate-y-0.5" />
                        </a>
                    </div>
                    <p class="text-xs text-white/50 mt-6">
                        Certificaciones de Competencias Laborales ChileValora y Certificaciones o Calificaciones Privadas, según lo que necesites acreditar.
                    </p>
                </div>
            </div>
        </section>

        {/* ¿QUÉ PUEDES CERTIFICAR? */}
        <section id="servicio" class="bg-white py-24 border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-bold tracking-widest uppercase mb-6">
                        <BadgeCheck size={16} /> ¿Qué puedes certificar?
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight">
                        Una alternativa según tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0B1E40] to-blue-800">experiencia y lo que necesitas acreditar</span>
                    </h2>
                    <p class="text-base md:text-lg text-slate-600">
                        Contamos con alternativas para diferentes oficios y especialidades.
                    </p>
                </div>

                <div class="relative max-w-3xl mx-auto bg-gradient-to-br from-[#0B1E40] to-[#122b59] rounded-2xl px-8 py-7 mb-16 text-center shadow-xl shadow-blue-900/20">
                    <Quote size={32} className="absolute -top-3 left-1/2 -translate-x-1/2 text-cyan-400 bg-[#0B1E40] rounded-full p-1.5" />
                    <p class="text-lg md:text-xl font-bold text-white leading-snug">
                        No se trata solo de decir que tienes experiencia.
                        <span class="text-cyan-300"> Se trata de poder demostrarla.</span>
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    {SERVICIO.map((item, index) => (
                        <div class="group relative bg-white p-8 rounded-2xl border border-slate-200 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.08)] hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0B1E40] to-cyan-400 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></div>
                            <span class="absolute top-6 right-7 text-3xl font-black text-slate-100 group-hover:text-blue-50 transition-colors select-none">{String(index + 1).padStart(2, '0')}</span>
                            <div class="relative w-12 h-12 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl flex items-center justify-center text-blue-600 mb-5 ring-1 ring-blue-100">
                                <item.icon size={22} />
                            </div>
                            <h3 class="relative text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
                            <p class="relative text-slate-600 leading-relaxed text-[15px]">{item.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* ORIENTACIÓN PERSONALIZADA */}
        <section id="proceso" class="bg-slate-50 py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-16 items-start">
                    <div class="lg:sticky lg:top-32 bg-white rounded-[2rem] border border-slate-200 shadow-[0_20px_50px_-25px_rgba(11,30,64,0.3)] p-8 md:p-10 overflow-hidden relative">
                        <div class="absolute -top-10 -right-10 w-40 h-40 bg-gradient-to-br from-cyan-400/10 to-blue-600/10 rounded-full blur-2xl"></div>
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-bold tracking-widest uppercase mb-6">
                            <MessageCircle size={16} /> Orientación personalizada
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight leading-tight">
                            Te orientamos para encontrar la alternativa adecuada
                        </h2>
                        <p class="text-slate-600 leading-relaxed text-base md:text-lg mb-8">
                            Revisaremos tu caso y te explicaremos de manera clara qué puedes certificar, qué alternativa puede corresponder y cómo comenzar.
                        </p>
                        <div class="space-y-3">
                            {ORIENTACION_PASOS.map((item, index) => (
                                <div class="flex gap-3.5">
                                    <div class="w-7 h-7 rounded-full bg-[#0B1E40] text-white flex items-center justify-center shrink-0 text-xs font-black">
                                        {index + 1}
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-slate-900 text-[13px]">{item.title}</h4>
                                        <p class="text-slate-500 text-xs leading-relaxed">{item.text}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <div class="h-1 w-16 rounded-full bg-gradient-to-r from-cyan-400 to-[#0B1E40] mt-8"></div>
                    </div>

                    <div class="relative">
                        <div class="hidden sm:block absolute left-[3.75rem] top-10 bottom-10 w-px bg-gradient-to-b from-cyan-400 via-blue-600 to-[#0B1E40]"></div>
                        <div class="space-y-5">
                            {CONSIDERACIONES.map((step, index) => (
                                <div class="group relative flex gap-5 items-start bg-white rounded-2xl border border-slate-200 shadow-[0_10px_30px_-18px_rgba(11,30,64,0.25)] hover:shadow-[0_20px_40px_-18px_rgba(11,30,64,0.25)] hover:-translate-y-0.5 transition-all p-6 pl-7 overflow-hidden">
                                    <div class={`absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b ${step.accent}`}></div>
                                    <span class="absolute right-4 bottom-1 text-6xl font-black text-slate-50 group-hover:text-blue-50 transition-colors select-none leading-none">
                                        {index + 1}
                                    </span>
                                    <div class={`relative z-10 w-14 h-14 rounded-2xl bg-gradient-to-br ${step.accent} text-white flex items-center justify-center shrink-0 shadow-lg shadow-blue-900/20`}>
                                        <step.icon size={22} />
                                    </div>
                                    <div class="relative z-10 pt-1.5">
                                        <h3 class="font-bold text-slate-900 mb-1.5">{step.title}</h3>
                                        <p class="text-slate-600 text-[15px] leading-relaxed">{step.text}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* EL VALOR DE CERTIFICARTE */}
        <section class="bg-white py-24 border-t border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-bold tracking-widest uppercase mb-6">
                        <Star size={16} /> El valor de certificarte
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight">
                        Tu experiencia puede abrirte <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0B1E40] to-blue-800">nuevas oportunidades</span>
                    </h2>
                    <p class="text-base md:text-lg text-slate-600">
                        Una certificación puede ayudarte a respaldar tu trayectoria, fortalecer tu presentación laboral y demostrar tus capacidades cuando una empresa o empleador necesita comprobar que sabes desempeñarte en una determinada actividad.
                    </p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    {VALOR.map((item, index) => (
                        <div class="group relative bg-white p-8 rounded-2xl border border-slate-200 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.08)] hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0B1E40] to-cyan-400 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></div>
                            <span class="absolute top-6 right-7 text-3xl font-black text-slate-100 group-hover:text-blue-50 transition-colors select-none">{String(index + 1).padStart(2, '0')}</span>
                            <div class="relative w-12 h-12 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl flex items-center justify-center text-blue-600 mb-5 ring-1 ring-blue-100">
                                <item.icon size={22} />
                            </div>
                            <h3 class="relative text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
                            <p class="relative text-slate-600 leading-relaxed text-[15px]">{item.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* CATÁLOGO DE PERFILES */}
        <div id="perfiles" class="bg-slate-50">
            <CatalogoPerfiles client:load perfiles={perfiles} title="Perfiles de evaluación" subtitle="Selecciona el área en la que deseas certificarte para iniciar el proceso de postulación." />
        </div>

        {/* DA EL SIGUIENTE PASO */}
        <section class="relative bg-[#050B14] py-24 overflow-hidden">
            <div class="absolute inset-0">
                <img src={HERO_IMG} alt="" class="w-full h-full object-cover opacity-25" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-b from-[#050B14] via-[#0B1E40]/90 to-[#050B14]"></div>
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[32rem] h-[32rem] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none"></div>

            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-cyan-300 text-sm font-bold tracking-widest uppercase mb-6 border border-white/10">
                    Da el siguiente paso
                </div>
                <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-5 tracking-tight">
                    Tu experiencia habla de lo que sabes hacer. Nosotros te ayudamos a demostrarlo.
                </h2>
                <p class="text-blue-100/85 text-base md:text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
                    Si tienes experiencia en un oficio o especialidad y quieres certificar lo que sabes hacer, conversemos.
                </p>
                <a href="#contacto" class="group inline-flex bg-gradient-to-r from-cyan-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg shadow-cyan-900/30 items-center justify-center gap-2">
                    Quiero certificarme <ArrowRight size={18} className="transition-transform group-hover:translate-x-1" />
                </a>
            </div>
        </section>

        {/* FORMULARIO */}
        <ContactForm
            client:idle
            title="Cuéntanos qué haces y revisemos tu alternativa"
            subtitle="Te orientamos, revisamos tu situación y te explicamos cómo comenzar el proceso."
            preselectedContext=""
        />
    </div>
</Layout>
