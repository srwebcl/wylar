---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Wylar">
    <section class="bg-slate-50 py-32 px-4">
        <div class="max-w-xl mx-auto text-center">
            <p class="text-sm font-bold uppercase tracking-widest text-blue-700 mb-4">Error 404</p>
            <h1 class="text-4xl md:text-5xl font-extrabold text-[#0B1E40] mb-5">No encontramos esta página</h1>
            <p class="text-slate-600 text-lg mb-10">
                Puede que el enlace esté desactualizado o que la certificación ya no esté disponible.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/catalogo" class="bg-[#0B1E40] hover:bg-blue-900 text-white font-bold px-8 py-3 rounded-xl transition-colors">Ver catálogo</a>
                <a href="/" class="bg-white border border-slate-200 hover:bg-slate-50 text-[#0B1E40] font-bold px-8 py-3 rounded-xl transition-colors">Ir al inicio</a>
            </div>
        </div>
    </section>
</Layout>
