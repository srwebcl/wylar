---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import CatalogoPerfiles from '../components/CatalogoPerfiles.jsx';
import FaqAccordion from '../components/perfil-templates/FaqAccordion.astro';
import { getCatalogList } from '../lib/catalog.js';
import {
  Building2,
  CheckCircle2,
  ArrowUpRight,
  Star,
  PlusCircle,
  BadgeCheck,
  Settings2,
  Landmark,
  FileSignature,
  FileCheck,
  Wallet,
  MapPin,
  Activity,
  SearchCheck,
  Award,
  Compass,
  ClipboardList,
  HeartHandshake,
  Quote,
  ArrowRight,
  ArrowDown,
} from 'lucide-react';

const HERO_IMG = '/images/catalog_rigger.jpg';

const QUE_GANA = [
  { icon: CheckCircle2, title: 'Reconocimiento formal', text: 'Reconozca y respalde formalmente las competencias de sus trabajadores.' },
  { icon: ArrowUpRight, title: 'Respaldo ante clientes', text: 'Puede demostrar ante clientes y mandantes que las personas que realizan sus servicios cuentan con competencias certificadas.' },
  { icon: Star, title: 'Propuesta de valor', text: 'Fortalezca la propuesta de valor y diferenciación de su empresa.' },
  { icon: PlusCircle, title: 'Fortalecimiento del equipo', text: 'Identifique oportunidades para fortalecer las competencias de su equipo.' },
  { icon: BadgeCheck, title: 'Perfil laboral', text: 'Fortalezca el perfil laboral de las personas que forman parte de su organización.' },
  { icon: Settings2, title: 'Proceso adaptado', text: 'Coordinamos la evaluación de acuerdo con las características y necesidades de su empresa.' },
];

const FRANQUICIA_REQUISITOS = [
  { title: 'Primera Categoría', text: 'Entre las condiciones se encuentra ser contribuyente de Primera Categoría ante el SII.' },
  { title: 'Planilla de remuneraciones', text: 'Contar con una planilla anual de remuneraciones imponibles superior a 35 UTM.' },
  { title: 'Cotizaciones previsionales', text: 'Mantener pagadas las cotizaciones previsionales de sus trabajadores, de acuerdo con las condiciones vigentes de SENCE.' },
];

const FRANQUICIA_ALTERNATIVAS = [
  { icon: Landmark, title: 'Franquicia Tributaria', text: 'Puede financiar procesos de evaluación y certificación si cumple los requisitos establecidos.' },
  { icon: FileSignature, title: 'Precontrato', text: 'Contempla alternativas para personas que no son actualmente trabajadoras, bajo las condiciones establecidas por SENCE.' },
  { icon: FileCheck, title: 'Postcontrato', text: 'También contempla esta alternativa bajo las condiciones establecidas por SENCE.' },
  { icon: Wallet, title: 'Recursos propios', text: 'También puede realizar el proceso directamente, sin utilizar la Franquicia Tributaria.' },
];

const COBERTURA_FEATURES = [
  { title: 'En sus instalaciones', text: 'Las evaluaciones pueden realizarse en las instalaciones de la empresa.' },
  { title: 'En el lugar de trabajo', text: 'También pueden desarrollarse en el lugar donde se desempeñan los trabajadores.' },
  { title: 'En otras comunas o regiones', text: 'Si necesita certificar trabajadores en otra comuna o región, coordinamos el proceso donde se encuentre su equipo.' },
];

const ETAPAS = [
  { icon: Activity, title: 'Evaluación', text: 'Se desarrollan las instancias de evaluación correspondientes al perfil y las condiciones del proceso.' },
  { icon: SearchCheck, title: 'Revisión y validación', text: 'Una vez realizada la evaluación, comienza la etapa de revisión y validación de los resultados.' },
  { icon: Award, title: 'Certificación', text: 'Posteriormente se completa la etapa de certificación. WYLAR informa y coordina con la empresa los tiempos correspondientes.' },
];

const ALIADO = [
  { icon: Compass, title: 'Orientación', text: 'Le ayudamos a revisar las alternativas disponibles para su organización.' },
  { icon: ClipboardList, title: 'Coordinación', text: 'Organizamos el proceso de acuerdo con las características de su empresa.' },
  { icon: HeartHandshake, title: 'Acompañamiento', text: 'Mantenemos la coordinación y entregamos información sobre el avance del proceso.' },
];

const FAQ_EMPRESAS = [
  { q: '¿Qué es la Evaluación y Certificación de Competencias Laborales?', a: 'Es un proceso mediante el cual se evalúan las competencias que una persona ha desarrollado en el trabajo, de acuerdo con un perfil ocupacional establecido por ChileValora. Cuando demuestra las competencias requeridas, obtiene una Certificación de Competencias Laborales.' },
  { q: '¿Qué requisitos debe cumplir un trabajador?', a: 'Los requisitos dependen del perfil ocupacional. En términos generales, la persona debe contar con experiencia y/o conocimientos relacionados con las competencias del perfil y cumplir las condiciones específicas que este establezca, incluyendo, cuando corresponda, licencias habilitantes, requisitos legales u otras exigencias.' },
  { q: '¿Cuánto dura la evaluación?', a: 'Depende del perfil y de las condiciones del proceso. Como referencia, en los procesos realizados por WYLAR, contempla habitualmente una evaluación de conocimientos y una evaluación práctica, con una duración aproximada de 3 horas cada una.' },
  { q: '¿En cuánto tiempo está disponible la certificación?', a: 'La evaluación y la certificación son etapas diferentes. Como referencia, la certificación puede demorar aproximadamente 40 días después de realizada la evaluación, considerando las etapas de revisión y validación. El plazo puede variar porque el proceso también depende de las etapas de revisión y certificación de ChileValora.' },
  { q: '¿Dónde se realiza la evaluación?', a: 'Puede realizarse en las instalaciones de la empresa, en el lugar de trabajo, en dependencias de WYLAR o en otro lugar adecuado para el proceso, según las condiciones del perfil.' },
  { q: '¿WYLAR realiza capacitación?', a: 'No. WYLAR es un Centro de Evaluación y Certificación de Competencias Laborales acreditado por ChileValora. Nuestra función es evaluar y certificar las competencias laborales. La capacitación es un proceso diferente y debe ser realizada por un OTEC.' },
  { q: '¿Cuánto cuesta certificar a un trabajador?', a: 'El valor depende del perfil ocupacional, sus unidades de competencia y las características de cada proceso. También pueden influir las condiciones de ejecución, traslado y lugar donde se realizará la evaluación. Consúltenos para recibir una propuesta.' },
];

const perfiles = await getCatalogList();
---

<Layout title="Certificación para Empresas | Wylar">
    <div class="animate-in fade-in duration-700 bg-slate-50">

        {/* HERO */}
        <section id="inicio" class="relative min-h-[60vh] md:min-h-[65vh] flex items-center bg-[#050B14] overflow-hidden border-b border-white/10">
            <div class="absolute inset-0">
                <img src={HERO_IMG} alt="Operación industrial certificada" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-[#0B1E40]/80"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#050B14] via-transparent to-[#050B14]/50"></div>
            <div class="absolute top-0 right-0 w-[32rem] h-[32rem] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-24">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2.5 pl-2.5 pr-4 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] text-white shadow-xl mb-8 border border-white/10">
                        <span class="w-6 h-6 rounded-full bg-cyan-400/20 flex items-center justify-center shrink-0">
                            <Building2 size={13} className="text-cyan-300" />
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest">Certificación para empresas</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6 text-white">
                        Certifique las <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-blue-300">competencias</span> de sus trabajadores
                    </h1>

                    <p class="text-lg md:text-xl text-white/80 leading-relaxed font-medium max-w-3xl mb-10">
                        Sus trabajadores son parte fundamental del valor que entrega su empresa. La Evaluación y Certificación de Competencias Laborales permite reconocer formalmente sus competencias y contar con un respaldo que puede fortalecer su propuesta frente a clientes, mandantes y nuevas oportunidades de negocio.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center gap-4">
                        <a href="#contacto" class="group bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg shadow-blue-950/40 flex items-center justify-center gap-2">
                            Solicitar orientación <ArrowRight size={18} className="transition-transform group-hover:translate-x-1" />
                        </a>
                        <a href="#franquicia" class="group bg-white hover:bg-slate-50 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                            Ver opciones de financiamiento <ArrowDown size={18} className="transition-transform group-hover:translate-y-0.5" />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* ¿QUÉ GANA SU EMPRESA? */}
        <section id="servicio" class="bg-white py-24 border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-bold tracking-widest uppercase mb-6">
                        <Star size={16} /> ¿Qué gana su empresa?
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight">
                        El valor de contar con <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0B1E40] to-blue-800">competencias certificadas</span>
                    </h2>
                    <p class="text-base md:text-lg text-slate-600">
                        La certificación permite reconocer formalmente las competencias de su equipo y respaldar sus capacidades ante distintos requerimientos de la empresa.
                    </p>
                </div>

                <div class="relative max-w-3xl mx-auto bg-gradient-to-br from-[#0B1E40] to-[#122b59] rounded-2xl px-8 py-7 mb-16 text-center shadow-xl shadow-blue-900/20">
                    <Quote size={32} className="absolute -top-3 left-1/2 -translate-x-1/2 text-cyan-400 bg-[#0B1E40] rounded-full p-1.5" />
                    <p class="text-lg md:text-xl font-bold text-white leading-snug">
                        Su equipo también es parte de su propuesta de valor.
                        <span class="text-cyan-300"> Demuestre sus competencias.</span>
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    {QUE_GANA.map((item, index) => (
                        <div class="group relative bg-white p-8 rounded-2xl border border-slate-200 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.08)] hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0B1E40] to-cyan-400 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></div>
                            <span class="absolute top-6 right-7 text-3xl font-black text-slate-100 group-hover:text-blue-50 transition-colors select-none">{String(index + 1).padStart(2, '0')}</span>
                            <div class="relative w-12 h-12 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl flex items-center justify-center text-blue-600 mb-5 ring-1 ring-blue-100">
                                <item.icon size={22} />
                            </div>
                            <h3 class="relative text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
                            <p class="relative text-slate-600 leading-relaxed text-[15px]">{item.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* FRANQUICIA TRIBUTARIA SENCE */}
        <section id="franquicia" class="bg-slate-50 py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-bold tracking-widest uppercase mb-6">
                        <Landmark size={16} /> Franquicia Tributaria SENCE
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight">
                        ¿Puede utilizar la <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0B1E40] to-blue-800">Franquicia Tributaria para certificar?</span>
                    </h2>
                    <p class="text-base md:text-lg text-slate-600">
                        Si su empresa cumple con los requisitos establecidos por SENCE, puede utilizar la Franquicia Tributaria para financiar procesos de Evaluación y Certificación de Competencias Laborales.
                    </p>
                </div>

                <div class="grid lg:grid-cols-2 gap-8 items-stretch">
                    <div class="bg-white rounded-[2rem] border border-slate-200 shadow-[0_20px_50px_-25px_rgba(11,30,64,0.25)] p-8 md:p-10 divide-y divide-slate-100">
                        {FRANQUICIA_REQUISITOS.map((item) => (
                            <div class="group flex gap-5 items-start py-5 first:pt-0 last:pb-0">
                                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                                    <CheckCircle2 size={20} />
                                </div>
                                <div class="pt-1">
                                    <h4 class="font-bold text-slate-900 text-base mb-1">{item.title}</h4>
                                    <p class="text-slate-500 text-sm leading-relaxed">{item.text}</p>
                                </div>
                            </div>
                        ))}
                    </div>

                    <div class="bg-white rounded-[2rem] border border-slate-200 shadow-[0_20px_50px_-25px_rgba(11,30,64,0.25)] p-8 md:p-10 divide-y divide-slate-100">
                        {FRANQUICIA_ALTERNATIVAS.map((item) => (
                            <div class="group flex gap-5 items-start py-4 first:pt-0 last:pb-0">
                                <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 group-hover:bg-[#0B1E40] group-hover:text-cyan-300 transition-colors">
                                    <item.icon size={20} />
                                </div>
                                <div class="pt-1">
                                    <h4 class="font-bold text-slate-900 text-base mb-1">{item.title}</h4>
                                    <p class="text-slate-500 text-sm leading-relaxed">{item.text}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* COBERTURA NACIONAL */}
        <section class="bg-white py-24 border-t border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col lg:flex-row gap-16 items-center">
                    <div class="w-full lg:w-1/2">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-100 text-cyan-700 text-sm font-bold tracking-widest uppercase mb-6">
                            <MapPin size={16} /> Cobertura nacional
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6 leading-tight">
                            Certificamos donde su empresa <span class="text-blue-600">lo necesite.</span>
                        </h2>
                        <p class="text-slate-700 leading-relaxed text-base mb-8">
                            WYLAR cuenta con cobertura nacional y coordina los procesos de evaluación de acuerdo con las características de cada empresa.
                        </p>
                        <div class="space-y-3.5">
                            {COBERTURA_FEATURES.map((item) => (
                                <div class="group flex gap-4 bg-white border border-slate-200 rounded-2xl p-4 hover:border-emerald-300 hover:shadow-[0_10px_30px_-18px_rgba(16,185,129,0.4)] transition-all">
                                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                                        <CheckCircle2 size={18} />
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-slate-900 text-[15px]">{item.title}</h4>
                                        <p class="text-slate-500 text-sm">{item.text}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 relative">
                        <div class="absolute -inset-3 bg-gradient-to-br from-blue-600 to-[#0B1E40] rounded-[2.5rem] opacity-90 blur-none"></div>
                        <div class="relative bg-gradient-to-br from-blue-600 to-[#0B1E40] rounded-[2rem] p-10 text-white shadow-2xl overflow-hidden min-h-[420px] flex flex-col justify-center">
                            <div class="absolute -right-10 -top-10 w-56 h-56 bg-white/10 rounded-full blur-2xl"></div>
                            <div class="absolute -bottom-10 -left-10 w-56 h-56 bg-cyan-400/10 rounded-full blur-2xl"></div>
                            <div class="relative w-14 h-14 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center mb-6">
                                <ArrowUpRight size={26} />
                            </div>
                            <h3 class="relative text-2xl font-bold text-white mb-4">Una evaluación adaptada al proceso</h3>
                            <p class="relative text-blue-100 leading-relaxed mb-4">
                                La evaluación puede realizarse en una jornada acotada, dependiendo del perfil y las condiciones del proceso.
                            </p>
                            <p class="relative text-blue-100 leading-relaxed">
                                Como referencia, en los procesos realizados por WYLAR, la evaluación contempla habitualmente una evaluación de conocimientos y una evaluación práctica, con una duración aproximada de 3 horas cada una. Pueden realizarse el mismo día o en jornadas diferentes, según corresponda.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* EVALUACIÓN Y CERTIFICACIÓN: SON ETAPAS DIFERENTES */}
        <section class="bg-slate-50 py-24 border-t border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-sm font-bold tracking-widest uppercase mb-6">
                        <Activity size={16} /> Evaluación y certificación
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-[#0B1E40] mb-5 tracking-tight">
                        Son etapas diferentes
                    </h2>
                    <p class="text-base md:text-lg text-slate-600">
                        Evaluarse puede tomar una jornada. Recibir la certificación es parte de un proceso posterior.
                    </p>
                </div>

                <div class="bg-white border border-slate-200 rounded-[2rem] shadow-[0_10px_40px_-18px_rgba(11,30,64,0.15)] overflow-hidden">
                    <div class="grid grid-cols-1 sm:grid-cols-3 divide-y divide-slate-100 sm:divide-y-0 sm:divide-x">
                        {ETAPAS.map((item, index) => (
                            <div class="group relative p-7 min-h-[210px] flex flex-col hover:bg-gradient-to-b hover:from-blue-50/60 hover:to-transparent transition-colors">
                                <span class="absolute top-6 right-7 text-xs font-black text-slate-200 group-hover:text-blue-300 transition-colors">{String(index + 1).padStart(2, '0')}</span>
                                <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:bg-[#0B1E40] group-hover:text-cyan-300 transition-colors">
                                    <item.icon size={20} />
                                </div>
                                <strong class="text-lg font-extrabold text-slate-900 leading-snug mb-2">{item.title}</strong>
                                <span class="text-sm text-slate-500">{item.text}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* CATÁLOGO DE PERFILES */}
        <div id="perfiles" class="bg-white">
            <CatalogoPerfiles client:load perfiles={perfiles} title="Perfiles disponibles para su empresa" subtitle="Revise el catálogo de especialidades técnicas habilitadas para evaluación." />
        </div>

        {/* UN ALIADO PARA SU EMPRESA */}
        <section class="relative bg-[#050B14] py-24 overflow-hidden">
            <div class="absolute inset-0">
                <img src={HERO_IMG} alt="" class="w-full h-full object-cover opacity-25" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-b from-[#050B14] via-[#0B1E40]/90 to-[#050B14]"></div>
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/15 rounded-full blur-[110px] pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-[28rem] h-[28rem] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
                <div class="max-w-2xl mb-14">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-cyan-300 text-sm font-bold tracking-widest uppercase mb-6 border border-white/10">
                        <HeartHandshake size={16} /> Un aliado para su empresa
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-5 tracking-tight">
                        Usted conoce las necesidades de su empresa. Nosotros conocemos el proceso.
                    </h2>
                    <p class="text-blue-100/85 text-base md:text-lg leading-relaxed">
                        Coordinamos el proceso con su empresa, orientamos a sus trabajadores y buscamos que la certificación se desarrolle de manera clara, ordenada y acorde a sus necesidades.
                    </p>
                </div>

                <div class="grid sm:grid-cols-3 gap-5">
                    {ALIADO.map((item, index) => (
                        <div class="group relative bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm hover:bg-white/[0.08] hover:border-cyan-400/30 hover:-translate-y-1 transition-all overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-cyan-400 to-blue-400 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></div>
                            <span class="absolute right-3 bottom-1 text-5xl font-black text-white/[0.05] group-hover:text-white/[0.08] transition-colors select-none leading-none">
                                {index + 1}
                            </span>
                            <div class="relative w-10 h-10 rounded-xl bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 flex items-center justify-center mb-4 group-hover:bg-cyan-400/25 transition-colors">
                                <item.icon size={18} />
                            </div>
                            <h4 class="relative font-bold text-white text-[15px] mb-1.5">{item.title}</h4>
                            <p class="relative text-blue-100/70 text-sm leading-relaxed">{item.text}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        {/* IMPACTO EN SU COMUNIDAD */}
        <section class="bg-white py-24 border-t border-slate-100">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="bg-slate-50 border border-slate-200 rounded-[2rem] p-8 md:p-12 flex flex-col md:flex-row items-start gap-8">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-500 flex items-center justify-center shrink-0 shadow-lg shadow-amber-500/20">
