---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
import CatalogoPerfiles from '../components/CatalogoPerfiles.jsx';
import { GraduationCap, Layers, FileCheck, Award, ArrowDown, ArrowRight, ShieldCheck, CheckCircle2, BookOpen } from 'lucide-react';

const QUE_PODEMOS_HACER = [
    'Identificar perfiles ChileValora relacionados con sus carreras.',
    'Detectar oportunidades de certificación para sus estudiantes.',
    'Incorporar certificaciones como salidas intermedias o al término de la carrera.',
    'Vincular la certificación con procesos de RAP y articulación formativa, cuando corresponda.',
    'Coordinar y ejecutar los procesos de evaluación y certificación.',
];
---

<Layout title="Alianzas para Instituciones de Educación | Wylar">
    <div class="animate-in fade-in duration-700 bg-slate-50 overflow-hidden">

        {/* HERO */}
        <section id="inicio" class="relative min-h-[60vh] md:min-h-[65vh] flex items-center bg-[#050B14] overflow-hidden border-b border-white/10">
            <div class="absolute inset-0">
                <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=2070&auto=format&fit=crop" alt="Estudiantes de carrera técnico-profesional" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-[#0B1E40]/80"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#050B14] via-transparent to-[#050B14]/50"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-24">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-[#0B1E40] to-[#122b59] text-white shadow-xl mb-8 border border-white/10">
                        <GraduationCap size={16} className="text-cyan-400" />
                        <span class="text-xs font-bold uppercase tracking-widest">Portal Instituciones de Educación</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6 text-white">
                        Conecte la formación con el <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-cyan-300">mundo laboral</span>
                    </h1>

                    <p class="text-lg md:text-xl text-white/80 leading-relaxed font-medium max-w-3xl mb-4">
                        En WYLAR, como Centro de Evaluación y Certificación de Competencias Laborales acreditado por ChileValora, ayudamos a liceos técnico-profesionales, CFT, Institutos Profesionales y universidades a incorporar la certificación de competencias laborales como parte de la trayectoria formativa de sus estudiantes.
                    </p>
                    <p class="text-base md:text-lg text-cyan-200 font-bold leading-relaxed max-w-3xl mb-10">
                        Porque hoy un estudiante puede hacer más que obtener un título: puede egresar con su título y, además, con sus competencias laborales certificadas.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center gap-4">
                        <a href="#contacto" class="bg-gradient-to-r from-[#0B1E40] to-blue-900 hover:from-blue-900 hover:to-blue-700 text-white font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2">
                            Coordinar Alianza <ArrowRight size={18} />
                        </a>
                        <a href="#proceso" class="bg-white hover:bg-slate-50 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                            Ver cómo funciona <ArrowDown size={18} />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* MÉTRICAS */}
        <section class="bg-white py-24 border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 divide-y md:divide-y-0 md:divide-x divide-slate-200 text-center">
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">RAP</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Reconocimiento de Aprendizajes Previos</div>
                    </div>
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">Nacional</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Validez del Certificado</div>
                    </div>
                    <div class="pt-8 md:pt-0">
                        <div class="text-5xl font-black text-[#0B1E40] mb-2 tracking-tight">Título + Cert.</div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Doble Reconocimiento al Egresar</div>
                    </div>
                </div>
            </div>
        </section>

        {/* CÓMO FUNCIONA */}
        <div id="proceso" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
            <div class="text-center mb-20 relative">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-100 rounded-full blur-[80px] -z-10"></div>
                <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6">Certificar antes de egresar es posible</h2>
                <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
                    De acuerdo con la carrera y los perfiles ocupacionales disponibles, sus estudiantes pueden acceder a procesos de certificación durante su formación.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8 relative">
                <div class="hidden md:block absolute top-24 left-1/6 right-1/6 h-0.5 bg-gradient-to-r from-blue-100 via-blue-300 to-blue-100 -z-10"></div>

                <div class="bg-white p-10 rounded-[2rem] border border-slate-100 text-center shadow-[0_10px_40px_-10px_rgba(0,0,0,0.05)] hover:-translate-y-2 transition-all duration-300 group">
                    <div class="w-20 h-20 mx-auto bg-white border-4 border-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-8 shadow-xl shadow-blue-900/5 group-hover:scale-110 transition-transform">
                        <Layers size={32} />
                    </div>
                    <div class="inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-500 font-black text-sm mb-4">OPCIÓN 1</div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Salida Intermedia</h3>
                    <p class="text-slate-600 leading-relaxed">En un punto intermedio de la carrera, cuando el estudiante ya domina las competencias de un perfil ocupacional específico.</p>
                </div>

                <div class="bg-white p-10 rounded-[2rem] border border-slate-100 text-center shadow-[0_10px_40px_-10px_rgba(0,0,0,0.05)] hover:-translate-y-2 transition-all duration-300 group">
                    <div class="w-20 h-20 mx-auto bg-white border-4 border-cyan-50 text-cyan-600 rounded-full flex items-center justify-center mb-8 shadow-xl shadow-cyan-900/5 group-hover:scale-110 transition-transform">
                        <FileCheck size={32} />
                    </div>
                    <div class="inline-block px-4 py-1 rounded-full bg-slate-100 text-slate-500 font-black text-sm mb-4">OPCIÓN 2</div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Práctica Profesional</h3>
                    <p class="text-slate-600 leading-relaxed">Mientras aplican lo aprendido en terreno, obteniendo un reconocimiento formal de las competencias ya desarrolladas.</p>
                </div>

                <div class="bg-gradient-to-br from-blue-600 to-[#0B1E40] p-10 rounded-[2rem] text-center shadow-[0_20px_50px_-10px_rgba(11,30,64,0.4)] hover:-translate-y-2 transition-all duration-300 group relative overflow-hidden text-white">
                    <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
                    <div class="w-20 h-20 mx-auto bg-white/10 backdrop-blur-sm border-4 border-white/20 text-white rounded-full flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
                        <Award size={32} />
                    </div>
                    <div class="inline-block px-4 py-1 rounded-full bg-white/20 text-white font-black text-sm mb-4">OPCIÓN 3</div>
                    <h3 class="text-2xl font-bold text-white mb-4">Término de la Carrera</h3>
                    <p class="text-blue-100 leading-relaxed">Al egresar, sumando al título una herramienta adicional para enfrentar el mundo laboral: la certificación oficial ChileValora.</p>
                </div>
            </div>
        </div>

        {/* BENEFICIOS */}
        <section id="beneficios" class="bg-white py-24 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col lg:flex-row gap-16 items-center">
                    <div class="w-full lg:w-1/2">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-700 text-sm font-bold tracking-widest uppercase mb-6">
                            <Award size={16} /> Valor Diferencial
                        </div>
                        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-8 leading-tight">
                            Trayectorias formativas <span class="text-blue-600">más flexibles.</span>
                        </h2>
                        <div class="space-y-6">
                            <div class="flex gap-5">
                                <div class="bg-blue-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-blue-600">
                                    <BookOpen size={24} />
                                </div>
                                <div>
                                    <h4 class="font-bold text-xl text-slate-900 mb-2">RAP: Reconocimiento de Aprendizajes Previos</h4>
                                    <p class="text-slate-600 leading-relaxed">En instituciones y carreras con mecanismos de articulación, una certificación ChileValora puede ser reconocida como aprendizaje previo y contribuir al reconocimiento o convalidación de determinadas asignaturas o módulos.</p>
                                </div>
                            </div>
                            <div class="flex gap-5">
                                <div class="bg-cyan-50 w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 text-cyan-600">
                                    <ShieldCheck size={24} />
                                </div>
                                <div>
                                    <h4 class="font-bold text-xl text-slate-900 mb-3">¿Qué podemos hacer con su institución?</h4>
                                    <ul class="space-y-2">
                                        {QUE_PODEMOS_HACER.map((item) => (
                                            <li class="flex items-start gap-2.5 text-slate-600 leading-relaxed">
                                                <CheckCircle2 size={16} className="text-blue-500 mt-1 shrink-0" />
                                                {item}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 relative">
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-600 to-cyan-400 rounded-3xl transform rotate-3 scale-105 opacity-20 blur-lg"></div>
                        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=2070&auto=format&fit=crop" alt="Estudiantes de carrera técnico-profesional" class="relative rounded-3xl shadow-2xl object-cover h-[500px] w-full" />
                        <div class="absolute -bottom-8 -left-8 bg-white p-6 rounded-2xl shadow-xl border border-slate-100 flex items-center gap-4">
                            <div class="bg-green-100 text-green-600 p-3 rounded-full"><CheckCircle2 size={24} /></div>
                            <div>
                                <div class="font-black text-xl text-slate-900">Convenio</div>
                                <div class="text-sm font-medium text-slate-500">Sin Costo de Instalación</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* CATÁLOGO DE PERFILES */}
        <div id="perfiles">
            <CatalogoPerfiles client:load title="Perfiles para sus Estudiantes" subtitle="Estos son los perfiles ChileValora que puede incorporar en la trayectoria formativa de sus carreras." />
        </div>

        {/* FORMULARIO */}
        <ContactForm
            client:idle
            title="Construyamos una Alianza"
            subtitle="Cuéntenos qué carreras imparte su institución y exploremos juntos las oportunidades de certificación. Conectamos la formación con las competencias que el mundo laboral reconoce."
            preselectedContext="instituciones"
        />
    </div>
</Layout>
