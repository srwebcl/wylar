---
// Formulario lateral de contacto, reutilizado por las 3 plantillas de ficha.
const { icon: Icon, title = 'Solicitar Evaluación', ctaLabel = 'Cotizar este perfil' } = Astro.props;
---

<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center shrink-0 text-amber-600">
            <Icon size={20} />
        </div>
        <h3 class="text-lg font-bold text-slate-900 leading-tight">{title}</h3>
    </div>

    <p class="text-slate-500 text-sm mb-5 font-medium">Déjanos tus datos y te enviaremos el temario y requisitos.</p>

    <form class="space-y-4" onsubmit="event.preventDefault(); alert('Formulario enviado exitosamente.');">
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nombre completo</label>
            <input type="text" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="Su nombre" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Teléfono</label>
            <input type="tel" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="+56 9 XXXXXXXX" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Correo</label>
            <input type="email" class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-[15px] font-medium" placeholder="correo@ejemplo.com" required />
        </div>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Modalidad</label>
            <select class="w-full px-3 py-2.5 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all cursor-pointer text-[15px] font-medium text-slate-700" required>
                <option value="persona">Soy persona</option>
                <option value="empresa">Somos Empresa / Institución</option>
            </select>
        </div>
        <button type="submit" class="w-full bg-[#0B1E40] hover:bg-blue-900 text-white font-bold text-sm py-3 rounded-xl transition-colors flex items-center justify-center gap-2 mt-2 shadow-lg">
            {ctaLabel}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
    </form>
</div>
