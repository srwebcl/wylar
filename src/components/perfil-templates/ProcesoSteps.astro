---
// Línea de tiempo vertical: se lee inequívocamente como secuencia, sin
// importar si son 4, 5 o 6 pasos (a diferencia de una grilla de 3 columnas,
// que deja una fila incompleta y no comunica "orden" con la misma claridad).
import { Award } from 'lucide-react';
const { steps = [] } = Astro.props;
const last = steps.length - 1;
---

<div class="relative max-w-2xl mx-auto">
    <div class="absolute left-6 top-6 bottom-6 w-0.5 bg-gradient-to-b from-blue-200 via-blue-200 to-amber-300"></div>
    <div class="space-y-10">
        {steps.map((step, index) => (
            <div class="relative pl-[4.5rem]">
                <div class={`absolute left-0 top-0 w-12 h-12 rounded-full flex items-center justify-center font-black text-lg ring-4 ring-slate-50 ${
                    index === last ? 'bg-gradient-to-br from-amber-400 to-amber-500 text-[#0B1E40]' : 'bg-[#0B1E40] text-white'
                }`}>
                    {index === last ? <Award size={20} /> : index + 1}
                </div>
                <div class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1.5">Paso {index + 1}</div>
                <h4 class="font-bold text-slate-900 text-lg mb-2 leading-snug">{step.title}</h4>
                <p class="text-slate-600 text-base leading-relaxed">{step.description}</p>
            </div>
        ))}
    </div>
</div>
