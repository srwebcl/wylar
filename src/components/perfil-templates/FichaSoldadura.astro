---
import { ShieldCheck, Wrench, CheckCircle2, QrCode, Users, Building2, GraduationCap } from 'lucide-react';
import HeroFicha from './HeroFicha.astro';
import Breadcrumb from './Breadcrumb.astro';
import SidebarForm from './SidebarForm.astro';
import FaqAccordion from './FaqAccordion.astro';
import ProcesoSteps from './ProcesoSteps.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import ContactModal from './ContactModal.astro';

const { perfil } = Astro.props;
const quienesIcons = [Users, Building2, GraduationCap];
---

<div class="bg-slate-50 min-h-screen pb-24 lg:pb-0">

    <HeroFicha perfil={perfil} badgeLabel="Certificación Privada" ctaLabel="Solicitar Cotización" ctaIcon={Wrench} whatsapp>
        <ShieldCheck slot="badge-icon" size={14} />
    </HeroFicha>

    <Breadcrumb title={perfil.title} />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid lg:grid-cols-3 gap-12">
            <div class="lg:col-span-2 space-y-16">

                <section class="space-y-4 text-slate-700 leading-relaxed">
                    <p class="text-xl font-bold text-slate-900 leading-snug">{perfil.heroHook}</p>
                    {perfil.queEs.map((p) => <p class="text-base">{p}</p>)}
                </section>

                {/* ESPECIFICACIONES TÉCNICAS — procesos, posiciones, materiales y
                    norma agrupados en una sola "hoja de datos" compacta. */}
                <section>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-1">Especificaciones técnicas</h2>
                    <p class="text-slate-500 text-base mb-5">Procesos, posiciones, materiales y norma de referencia que calificamos.</p>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-white border border-slate-200 rounded-2xl p-5">
                            <div class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Procesos de soldadura</div>
                            <div class="grid grid-cols-2 gap-2.5">
                                {perfil.procesos.map((proc) => (
                                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-center">
                                        <div class="font-mono font-black text-lg text-[#0B1E40] tracking-tight">{proc.code}</div>
                                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wide mt-0.5">{proc.name}</div>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-2xl p-5">
                            <div class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Posiciones</div>
                            <div class="space-y-3">
                                <div>
                                    <div class="text-xs font-bold text-slate-600 mb-1.5">Placa</div>
                                    <div class="flex flex-wrap gap-1.5">
                                        {perfil.posiciones.placa.map((pos) => (
                                            <span class="font-mono font-bold text-xs bg-slate-50 border border-slate-200 text-[#0B1E40] px-2.5 py-1 rounded-md">{pos}</span>
                                        ))}
                                    </div>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-slate-600 mb-1.5">Tubería</div>
                                    <div class="flex flex-wrap gap-1.5">
                                        {perfil.posiciones.tuberia.map((pos) => (
                                            <span class="font-mono font-bold text-xs bg-slate-50 border border-slate-200 text-[#0B1E40] px-2.5 py-1 rounded-md">{pos}</span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-2xl p-5">
                            <div class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Materiales</div>
                            <ul class="space-y-1.5">
                                {perfil.materiales.items.map((m) => (
                                    <li class="flex items-start gap-2 text-[15px] text-slate-700">
                                        <CheckCircle2 size={14} className="text-blue-600 mt-0.5 shrink-0" /> {m}
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <div class="bg-[#0B1E40] text-white rounded-2xl p-5">
                            <div class="text-amber-400 text-xs font-black uppercase tracking-widest mb-2">Norma de referencia</div>
                            <h3 class="text-base font-extrabold mb-1.5 leading-snug">{perfil.normas.title}</h3>
                            <p class="text-slate-300 text-[13px] leading-relaxed">{perfil.normas.text}</p>
                        </div>
                    </div>

                    <p class="text-slate-500 text-sm leading-relaxed mt-4">{perfil.posiciones.note} {perfil.materiales.note}</p>
                </section>

                <section>
                    <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 text-[15px] text-amber-900 mb-10">
                        <span class="font-bold">¿Necesitas calificar otro proceso de soldadura?</span> {perfil.necesitasOtroProceso}
                    </div>

                    <h2 class="text-2xl font-extrabold text-slate-900 mb-3">{perfil.aMedida.title}</h2>
                    <p class="text-slate-700 leading-relaxed text-base mb-4">{perfil.aMedida.text}</p>
                    <ul class="grid sm:grid-cols-2 gap-2.5 mb-4">
                        {perfil.aMedida.items.map((it) => (
                            <li class="flex items-start gap-2.5 text-[15px] text-slate-600">
                                <span class="mt-2 w-1 h-1 rounded-full bg-amber-500 shrink-0"></span> {it}
                            </li>
                        ))}
                    </ul>
                    <p class="text-slate-800 font-medium text-base">{perfil.aMedida.closing}</p>
                </section>

                <section>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-4">¿Qué incluye el servicio?</h2>
                    <ul class="space-y-2">
                        {perfil.incluye.map((it) => (
                            <li class="flex items-start gap-3 text-[15px] text-slate-700 bg-white border border-slate-200 rounded-lg px-4 py-2.5">
                                <CheckCircle2 size={16} className="text-amber-500 mt-0.5 shrink-0" /> {it}
                            </li>
                        ))}
                    </ul>
                </section>

                <section>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-5">¿Quiénes pueden solicitar este servicio?</h2>
                    <div class="grid sm:grid-cols-3 gap-4">
                        {perfil.quienesPueden.map((item, index) => {
                            const Icon = quienesIcons[index];
                            return (
                                <div class="bg-white border border-slate-200 rounded-xl p-5 text-center">
                                    <div class="w-11 h-11 mx-auto bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-center mb-3 text-[#0B1E40]">
                                        <Icon size={20} />
                                    </div>
                                    <h3 class="font-bold text-base text-slate-900 mb-1.5">{item.title}</h3>
                                    <p class="text-slate-600 text-[13px] leading-relaxed">{item.text}</p>
                                </div>
                            );
                        })}
                    </div>
                </section>

                <section>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-8">¿Cómo es el proceso?</h2>
                    <ProcesoSteps steps={perfil.proceso} />
                </section>

                <section class="bg-[#0B1E40] text-white rounded-2xl p-7">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
                            <QrCode size={22} />
                        </div>
                        <div>
                            <h2 class="text-xl font-extrabold mb-3">{perfil.trazabilidad.title}</h2>
                            <p class="text-slate-300 leading-relaxed text-[15px] mb-4">{perfil.trazabilidad.text}</p>
                            <ul class="grid sm:grid-cols-2 gap-2 mb-4">
                                {perfil.trazabilidad.items.map((it) => (
                                    <li class="flex items-center gap-2 text-[15px] text-slate-200 font-medium">
                                        <CheckCircle2 size={15} className="text-amber-400 shrink-0" /> {it}
                                    </li>
                                ))}
                            </ul>
                            <p class="text-slate-400 text-[13px] leading-relaxed">{perfil.trazabilidad.closing}</p>
                        </div>
                    </div>
                </section>

                <section>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Preguntas frecuentes</h2>
                    <FaqAccordion faq={perfil.faq} />
                </section>

            </div>

            <div class="lg:col-span-1">
                <div class="lg:sticky lg:top-28">
                    <SidebarForm icon={Wrench} title="Solicitar Cotización" ctaLabel="Cotizar calificación" certificationInterest={perfil.title} />
                </div>
            </div>
        </div>
    </div>

    {/* CIERRE */}
    <section class="bg-[#0B1E40] text-white py-16 border-t-4 border-amber-500">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center mb-6">
                <Wrench size={22} className="text-amber-400" />
            </div>
            <h2 class="text-2xl md:text-3xl font-extrabold mb-6">{perfil.cierre.title}</h2>
            <ul class="text-left inline-block space-y-2 mb-6">
                {perfil.cierre.items.map((it) => (
                    <li class="flex items-start gap-2.5 text-blue-100 text-[15px]">
                        <CheckCircle2 size={15} className="text-amber-400 mt-0.5 shrink-0" /> {it}
                    </li>
                ))}
            </ul>
            <p class="text-blue-100/85 leading-relaxed mb-9 max-w-2xl mx-auto text-base">{perfil.cierre.closing}</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button type="button" data-open-form class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-[#0B1E40] font-bold text-sm uppercase tracking-widest px-7 py-3.5 rounded-xl transition-all shadow-lg">
                    Solicitar Cotización
                </button>
                <a href="https://wa.me/56912345678" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm uppercase tracking-widest px-7 py-3.5 rounded-xl transition-all backdrop-blur-sm">
                    Contactar por WhatsApp
                </a>
            </div>
        </div>
    </section>

    <MobileCtaBar icon={Wrench} label="Solicitar cotización" />
    <ContactModal title="Solicitar Cotización" ctaLabel="Enviar solicitud" certificationInterest={perfil.title} />

</div>
