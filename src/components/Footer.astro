---
import { ChevronRight, MapPin, Mail, Phone } from 'lucide-react';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050B14] text-slate-400 py-16 border-t-[4px] border-[#0B1E40]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-12">
        <div class="col-span-1 md:col-span-2">
            <div class="mb-8">
                <img src="/images/logo-blanco.webp" alt="Wylar Logo" class="h-14 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
            </div>
            <p class="mb-8 pr-8 text-slate-400 leading-relaxed font-medium">
                Centro de Evaluación y Certificación de Competencias Laborales acreditado por ChileValora. Transmitimos confianza, respaldo institucional y excelencia técnica en cada proceso.
            </p>
            <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mt-4">
                <img src="/logos-clientes/sello-chilevalora-circular.png" alt="Sello ChileValora" class="w-32 h-32 md:w-40 md:h-40 object-contain bg-white rounded-full shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:scale-105 transition-all duration-300 border-2 border-white/10" />
                <img src="/logos-clientes/sence.png" alt="Sence" class="h-20 md:h-24 w-auto object-contain bg-white rounded-2xl shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:scale-105 transition-all duration-300 border-2 border-white/10 px-6 py-4" />
            </div>
        </div>
        
        <div>
            <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-widest">Servicios</h4>
            <ul class="space-y-4 font-medium text-[15px]">
                <li><a href="/empresas" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Para Empresas</a></li>
                <li><a href="/instituciones" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Para Instituciones de Educación</a></li>
                <li><a href="/personas" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Para Personas</a></li>
                <li><a href="/perfil/electricista" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Instalador Eléctrico</a></li>
                <li><a href="/validador" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Validación Oficial</a></li>
            </ul>
        </div>
        
        <div>
            <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-widest">Institucional</h4>
            <ul class="space-y-4 font-medium text-[15px]">
                <li><a href="/chilevalora" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Sobre ChileValora</a></li>
                <li><a href="/chilevalora#centros" class="hover:text-white transition-colors flex items-center gap-2"><ChevronRight size={14} class="text-blue-500" /> Centros Acreditados</a></li>
            </ul>
        </div>

        <div>
            <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-widest">Contacto Directo</h4>
            <ul class="space-y-5 font-medium text-[15px]">
                <li class="flex items-start gap-3">
                    <MapPin size={18} class="text-blue-500 mt-0.5 flex-shrink-0" /> 
                    <span>Cobertura Nacional<br/><span class="text-slate-500 text-sm">Operaciones en todo Chile</span></span>
                </li>
                <li class="flex items-center gap-3">
                    <Mail size={18} class="text-blue-500 flex-shrink-0" /> 
                    <a href="mailto:contacto@wylar.cl" class="hover:text-white transition-colors">contacto@wylar.cl</a>
                </li>
                <li class="flex items-center gap-3">
                    <Phone size={18} class="text-blue-500 flex-shrink-0" /> 
                    <a href="tel:+56912345678" class="hover:text-white transition-colors">+56 9 1234 5678</a>
                </li>
            </ul>
        </div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-8 border-t border-slate-800/50 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500 font-medium">
        <p>© {currentYear} WYLAR Ltda.</p>
        <div class="flex items-center gap-4">
            <a href="/politicas-privacidad" class="hover:text-white transition-colors">Políticas de Privacidad</a>
            <span class="text-slate-700">|</span>
            <a href="/cookies" class="hover:text-white transition-colors">Uso de Cookies</a>
        </div>
        <p>Centro Acreditado ChileValora.</p>
    </div>
</footer>

<!-- BOTÓN FLOTANTE DE WHATSAPP -->
<a
    href="https://wa.me/56912345678"
    target="_blank"
    rel="noreferrer"
    class="fixed bottom-6 right-6 bg-[#25D366] text-white p-4 rounded-full shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-300 z-50 flex items-center justify-center group"
    aria-label="Contactar por WhatsApp"
>
    <span class="absolute right-16 bg-white text-slate-800 text-sm font-bold px-4 py-2 rounded shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
        Cotizar ahora
    </span>
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    </svg>
</a>
