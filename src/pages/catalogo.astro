---
import Layout from '../layouts/Layout.astro';
import CatalogoInteractivo from '../components/CatalogoInteractivo.jsx';
import ContactForm from '../components/ContactForm.jsx';
---

<Layout title="Certificaciones | Wylar">
    <div class="animate-in fade-in duration-500 bg-slate-50">
        
        {/* HEADER CATALOGO - STANDARD PREMIUM */}
        <section class="relative pt-24 pb-20 overflow-hidden bg-slate-50">
            {/* Background elements */}
            <div class="absolute inset-0 w-full h-full">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-white to-cyan-50/30"></div>
                <div class="absolute top-0 -left-1/4 w-[150%] h-[150%] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-100/40 via-transparent to-transparent -z-10 rotate-12"></div>
                <div class="absolute top-0 right-0 w-1/2 h-full bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-cyan-100/30 via-transparent to-transparent -z-10"></div>
                {/* Subtle Grid */}
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    {/* Badge */}
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0B1E40] text-white shadow-xl shadow-blue-900/20 mb-8 border border-blue-800/50">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path><path d="m9 12 2 2 4-4"></path></svg>
                        <span class="text-xs font-bold uppercase tracking-widest">Catálogo Oficial</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#0B1E40] tracking-tight leading-tight mb-6">
                        Encuentra la <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-blue-800 to-[#0B1E40]">certificación perfecta</span> para ti
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-medium max-w-3xl">
                        Explora nuestra biblioteca de perfiles de ChileValora y certificaciones privadas. Filtra por sector, público objetivo y tipo para encontrar rápidamente lo que necesitas.
                    </p>
                </div>
            </div>
        </section>

        {/* COMPONENTE INTERACTIVO */}
        <CatalogoInteractivo client:load />
        
        {/* FORMULARIO */}
        <ContactForm 
            client:idle
            title="Cotiza tu evaluación" 
            subtitle="Si ya sabes qué perfil te interesa, escríbenos para iniciar el proceso." 
            preselectedContext=""
        />
    </div>
</Layout>
