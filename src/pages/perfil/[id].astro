---
import Layout from '../../layouts/Layout.astro';
import { Zap, CheckCircle2, AlertTriangle, FileText, Activity, ShieldCheck, Wrench, Users, Construction, ArrowRight } from 'lucide-react';
import { perfiles } from '../../data/perfiles.js';

export function getStaticPaths() {
    return perfiles.map(perfil => ({
        params: { id: perfil.id },
        props: { perfil }
    }));
}

const { perfil } = Astro.props;
---

<Layout title={`Ficha Técnica: ${perfil.title} | Wylar`}>
    <div class="animate-in fade-in duration-500 bg-slate-50 min-h-screen">
        
        {/* HEADER FICHA TÉCNICA */}
        <div class="bg-[#0B1E40] text-white pt-24 pb-16 relative border-b-4 border-amber-500">
            <div class="absolute inset-0 bg-slate-900 overflow-hidden">
                <img src={perfil.image} alt={perfil.title} class="w-full h-full object-cover opacity-10 mix-blend-luminosity" />
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="flex flex-col md:flex-row gap-8 items-start justify-between">
                    <div class="flex-1">
                        <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded text-xs font-bold uppercase tracking-widest mb-6">
                            <ShieldCheck size={14} /> {perfil.isChileValora ? 'Certificada por ChileValora' : 'Certificación Privada'}
                        </div>
                        <h1 class="text-3xl md:text-5xl font-extrabold mb-4 tracking-tight">{perfil.title}</h1>
                        <p class="text-lg text-slate-300 max-w-2xl font-medium">{perfil.description}</p>
                    </div>
                    
                    {/* Ficha Identificación */}
                    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 min-w-[300px] w-full md:w-auto shrink-0">
                        <h4 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4">Ficha de Identificación</h4>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between border-b border-white/10 pb-2">
                                <span class="text-slate-300">Sector</span>
                                <span class="font-bold text-white">{perfil.sector || perfil.category}</span>
                            </div>
                            {perfil.subsector && (
                                <div class="flex justify-between border-b border-white/10 pb-2">
                                    <span class="text-slate-300">Subsector</span>
                                    <span class="font-bold text-white">{perfil.subsector}</span>
                                </div>
                            )}
                            {perfil.nivel && (
                                <div class="flex justify-between">
                                    <span class="text-slate-300">Nivel Cualificación</span>
                                    <span class="font-bold text-white">{perfil.nivel}</span>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* CONTENIDO TÉCNICO */}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
            <div class="grid lg:grid-cols-3 gap-12">
                
                {/* Columna Izquierda: Detalles */}
                <div class="lg:col-span-2 space-y-12">
                    
                    <section>
                        <h2 class="text-2xl font-extrabold text-slate-900 mb-6 flex items-center gap-3">
                            <FileText class="text-blue-600" /> Propósito del Perfil
                        </h2>
                        <div class="bg-white p-6 rounded-xl border border-slate-200 text-slate-700 leading-relaxed shadow-sm text-lg font-medium">
                            {perfil.proposito || perfil.description}
                        </div>
                    </section>

                    {perfil.ucls && perfil.ucls.length > 0 && (
                        <section>
                            <h2 class="text-2xl font-extrabold text-slate-900 mb-6 flex items-center gap-3">
                                <Activity class="text-blue-600" /> Unidades de Competencia (UCL) a evaluar
                            </h2>
                            <div class="space-y-4">
                                {perfil.ucls.map((ucl, index) => (
                                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex gap-4 transition-all hover:shadow-md hover:border-blue-200">
                                        <div class="bg-slate-100 text-[#0B1E40] w-10 h-10 rounded-lg flex items-center justify-center font-bold text-lg flex-shrink-0">
                                            {index + 1}
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-slate-900 text-lg mb-2">{ucl.title}</h4>
                                            <p class="text-slate-600 text-sm leading-relaxed">{ucl.description}</p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}
                </div>

                {/* Columna Derecha: Sidebar Sticky Form */}
                <div class="lg:col-span-1">
                    <div class="sticky top-24 bg-white p-6 rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center shrink-0">
                                {perfil.category === 'Construcción' && <Construction size={20} class="text-amber-600" />}
                                {perfil.category === 'Industrial' && <Wrench size={20} class="text-amber-600" />}
                                {perfil.category === 'Salud' && <Users size={20} class="text-amber-600" />}
                                {!['Construcción', 'Industrial', 'Salud'].includes(perfil.category) && <Zap size={20} class="text-amber-600" />}
                            </div>
                            <h3 class="text-lg font-bold text-slate-900 leading-tight">Solicitar Evaluación</h3>
                        </div>
                        
                        <p class="text-slate-500 text-xs mb-5 font-medium">Déjanos tus datos y te enviaremos el temario y requisitos.</p>
                        
                        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Formulario enviado exitosamente.');">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nombre completo</label>
                                <input type="text" class="w-full px-3 py-2 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-sm font-medium" placeholder="Su nombre" required />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Teléfono</label>
                                <input type="tel" class="w-full px-3 py-2 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-sm font-medium" placeholder="+56 9 XXXXXXXX" required />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Correo</label>
                                <input type="email" class="w-full px-3 py-2 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all text-sm font-medium" placeholder="correo@ejemplo.com" required />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Modalidad</label>
                                <select class="w-full px-3 py-2 bg-slate-50 rounded-lg border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 outline-none transition-all cursor-pointer text-sm font-medium text-slate-700" required>
                                    <option value="persona">Soy persona</option>
                                    <option value="empresa">Somos Empresa / Institución</option>
                                </select>
                            </div>
                            <button type="submit" class="w-full bg-[#0B1E40] hover:bg-blue-900 text-white font-bold text-sm py-3 rounded-xl transition-colors flex items-center justify-center gap-2 mt-2 shadow-lg">
                                Cotizar este perfil <ArrowRight size={16} />
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        {/* ALERTA SEC O ALERTAS ESPECÍFICAS */}
        {perfil.alert && (
            <section class="bg-blue-50 border-y border-blue-100 py-12">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center gap-8">
                    <div class="bg-blue-600 text-white p-4 rounded-full flex-shrink-0">
                        <AlertTriangle size={32} />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-[#0B1E40] mb-2">{perfil.alert.title}</h3>
                        <p class="text-slate-700 leading-relaxed font-medium">
                            {perfil.alert.description}
                        </p>
                    </div>
                </div>
            </section>
        )}
    </div>
</Layout>
