---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
---

<Layout title="Contacto | Wylar">
    <div class="animate-in fade-in duration-500 bg-slate-50">
        {/* Page Header - STANDARD PREMIUM */}
        <section class="relative pt-24 pb-20 overflow-hidden bg-slate-50">
            {/* Background elements */}
            <div class="absolute inset-0 w-full h-full">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-white to-cyan-50/30"></div>
                <div class="absolute top-0 -left-1/4 w-[150%] h-[150%] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-100/40 via-transparent to-transparent -z-10 rotate-12"></div>
                <div class="absolute top-0 right-0 w-1/2 h-full bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-cyan-100/30 via-transparent to-transparent -z-10"></div>
                {/* Subtle Grid */}
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>
            </div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
                    {/* Badge */}
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0B1E40] text-white shadow-xl shadow-blue-900/20 mb-8 border border-blue-800/50">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                        <span class="text-xs font-bold uppercase tracking-widest">Atención Inmediata</span>
                    </div>

                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#0B1E40] tracking-tight leading-tight mb-6">
                        Ponte en contacto <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-blue-800 to-[#0B1E40]">con nosotros</span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-medium max-w-3xl">
                        Estamos aquí para resolver tus dudas, guiarte en el proceso de certificación o coordinar una alianza estratégica.
                    </p>
                </div>
            </div>
        </section>

    {/* Formulario */}
    <ContactForm client:load hideHeader={true} />

    {/* Datos de contacto adicionales */}
    <section class="bg-slate-50 py-16 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {/* Teléfono */}
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm text-center hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <h3 class="font-bold text-slate-900 mb-2 text-lg">Llámanos</h3>
                    <p class="text-slate-500 font-medium">+56 9 1234 5678</p>
                </div>
                
                {/* Email */}
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm text-center hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                    </div>
                    <h3 class="font-bold text-slate-900 mb-2 text-lg">Escríbenos</h3>
                    <p class="text-slate-500 font-medium">contacto@wylar.cl</p>
                </div>
                
                {/* Dirección */}
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm text-center hover:shadow-md transition-shadow">
                    <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <h3 class="font-bold text-slate-900 mb-2 text-lg">Visítanos</h3>
                    <p class="text-slate-500 font-medium">Av. Providencia 1234, Santiago</p>
                </div>
            </div>
        </div>
    </section>
    </div>
</Layout>
